<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: oḷvā ḷamalai, vaṇṇam: atu, tūkku: atu.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati6.56">
        <l>viḻavuvīṟ ṟirunta viyalu ḷāṅkaṭ</l>
        <l>kōṭiyar muḻaviṉ muṉṉa rāṭal</l>
        <l>vallā ṉallaṉ vāḻkavavaṉ kaṇṇi </l>
        <l>valampaṭu  muracan tuvaippa vāḷuyart</l>
        <l>tilaṅkum pūṇaṉ polaṅkoṭi yuḻiñaiyaṉ</l>
        <l>maṭamperu maiyi ṉuṭaṉṟu mēl vanta</l>
        <l><hi rend="bold">vēntumeym maṟanta vāḻcci</hi></l>
        <l>vīntuku pōrkkaḷat tāṭuṅ kōvē.</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

