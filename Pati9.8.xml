<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: centuṟaip pāṭāṇpāṭṭu, vaṇṇam: atu, tūkku: atu.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati9.88">
        <l>vaiyaka malarnta toḻiṉmuṟai yoḻiyātu</l>
        <l>kaṭavuṭ pēṇiya kāṉamoṭu kalluyarntu</l>
        <l>teṇkaṭal vaḷaiiya malartalai yulakattut</l>
        <l>tampeyar pōkiya voṉṉār tēyat</l>
        <l>tuḷaṅkiruṅ kuṭṭan tolaiya vēliṭ</l>
        <l>ṭaṇaṅkuṭaik kaṭampiṉ muḻumuta ṟaṭintu</l>
        <l>porumura ṇeytiya kaḻuvuḷ puṟampeṟṟu</l>
        <l>nāma maṉṉar tuṇiya nūṟik</l>
        <l>kālval puravi yaṇṭa rōṭṭic</l>
        <l>cuṭarvī vākai naṉṉaṟ ṟēyttuk</l>
        <l>kuruti vitirtta kuvavuccōṟṟuk kuṉṟō</l>
        <l>ṭurukeḻu marapi ṉayirai paraii </l>
        <l>vēntarum vēḷirum piṉvantu paṇiyak</l>
        <l>koṟṟa meytiya periyōr maruka</l>
        <l>viyaluḷai yarimāṉ maṟaṅkeḻu kurucil</l>
        <l>viravuppaṇai muḻaṅku niraitōl varaippi</l>
        <l>ṉuravukkaḷiṟṟu velkoṭi nuṭaṅkum pācaṟai</l>
        <l>yāreyi lalaitta <hi rend="bold">kalkāl kavaṇai</hi></l>
        <l>nārari naṟaviṟ koṅkar kōvē</l>
        <l>yuṭalunart taputta polantērk kurucil</l>
        <l>vaḷaikaṭaṉ muḻaviṟ ṟoṇṭiyōr poruna</l>
        <l>nīnīṭu vāḻiya peruma niṉvayiṟ</l>
        <l>ṟuvaitta tumpai naṉavuṟṟu viṉavu</l>
        <l>māṟṟarun teyvattuk kūṟṟa muṉṉiya</l>
        <l>puṉaṉmali pēriyā ṟiḻitan tāṅku</l>
        <l>varunar varaiyāc ceḻumpaḵ ṟāraṅ </l>
        <l>koḷakkoḷak kuṟaiyātu talaittalaic ciṟappa</l>
        <l>vōvat taṉṉa vurukeḻu neṭunakarp</l>
        <l>pāvai yaṉṉa makaḷir nāppaṭ </l>
        <l>pukaṉṟa māṇpoṟip polinta cāntamoṭu</l>
        <l>taṇkamaḻ kōtai cūṭip pūṇcumantu</l>
        <l>tiruviṟ kulaiit tirumaṇi puraiyu</l>
        <l>murukeḻu karuviya perumaḻai cērntu</l>
        <l>vēṅkai virintu vicumpuṟu cēṭcimai</l>
        <l>yaruvi yaruvarai yaṉṉa mārpiṟ</l>
        <l>cēṇāṟu nallicaic cēyiḻai kaṇava</l>
        <l>mākañ cuṭara māvicum pukakkum</l>
        <l>ñāyiṟu pōla viḷaṅkuti paṉṉā</l>
        <l>ḷīṅkuk kāṇku vantaṉeṉ yāṉē</l>
        <l>yuṟukā leṭutta vōṅkuvaraṟ puṇari</l>
        <l>nuṇmaṇa laṭaikarai yuṭaitarun</l>
        <l>taṇkaṭaṟ paṭappai nāṭukiḻa vōyē.</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

