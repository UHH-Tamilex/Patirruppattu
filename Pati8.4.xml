<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: centuṟaip pāṭāṇpāṭṭu, vaṇṇam: oḻukuvaṇṇam, tūkku: centūkku.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati8.74">
        <l>kēḷvi kēṭṭup paṭiva moṭiyātu</l>
        <l>vēḷvi vēṭṭaṉai yuyarntō ruvappac</l>
        <l>cāyaṟal kaṭukkun tāḻiruṅ kūntal</l>
        <l>vēṟupaṭu tiruvi ṉiṉvaḻi vāḻiyar</l>
        <l>koṭumaṇaṟ paṭṭa viṉaimā ṇaruṅkalam</l>
        <l>pantarp payanta palarpukaḻ muttam</l>
        <l>varaiyaka naṇṇik kuṟumpoṟai nāṭit</l>
        <l>teriyunar koṇṭa ciraṟuṭaip paimpoṟik</l>
        <l>kavaimaraṅ kaṭukkuṅ kavalaiya maruppiṟ</l>
        <l>puḷḷi yiralait tōlū ṉutirttut</l>
        <l>tītukaḷain teñciya tikaḻviṭu pāṇṭiṟ </l>
        <l>paruti pōkiya puṭaikiḷai kaṭṭi</l>
        <l>yeḵkuṭai yirumpi ṉuḷḷamaittu vallōṉ</l>
        <l>cūṭunilai yuṟṟa cuṭarviṭu tōṟṟam</l>
        <l>vicumpāṭu marapiṟ paruntū ṟaḷappa</l>
        <l><hi rend="bold">nalampeṟu tirumaṇi</hi> kūṭṭu naṟṟō</l>
        <l>ḷoṭuṅkī rōti yoṇṇutal karuvi</l>
        <l>leṇṇiyaṉ muṟṟi yīraṟivu purintu</l>
        <l>cālpuñ cemmaiyu muḷappaṭap piṟavuṅ</l>
        <l>kāvaṟ kamainta varacutuṟai pōkiya</l>
        <l>vīṟucāl putalvarp peṟṟaṉai yivaṇark</l>
        <l>karuṅkaṭa ṉiṟutta ceruppukaṉ muṉpa</l>
        <l>vaṉṉavai maruṇṭaṉe ṉallē ṉiṉvayiṉ</l>
        <l>muḻutuṇarn toḻuku naraimū tāḷaṉai</l>
        <l>vaṇmaiyu māṇmaiyum vaḷaṉu meccamun </l>
        <l>teyvamum yāvatun tavamuṭai yōṟkeṉa </l>
        <l>vēṟupaṭu naṉantalaip peyarak</l>
        <l>kūṟiṉai perumaniṉ paṭimai yāṉē.</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

