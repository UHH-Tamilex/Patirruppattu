<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: centuṟaip pāṭāṇpāṭṭu, vaṇṇam: atu, tūkku: atu.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati7.63">
        <l>pārppārk kallatu paṇipaṟi yalaiyē</l>
        <l>paṇiyā vuḷḷamo ṭaṇivarak keḻīi</l>
        <l>naṭṭōrk kallatu kaṇṇañ calaiyē</l>
        <l>vaṇaṅkucilai porutaniṉ maṇaṅkama ḻakala</l>
        <l>makaḷirk kallatu malarppaṟi yalaiyē</l>
        <l>nilantiṟam peyaruṅ kālai yāyiṉuṅ</l>
        <l>kiḷanta coṉṉī poyppaṟi yalaiyē</l>
        <l>ciṟiyilai yuḻiñait teriyal cūṭik</l>
        <l>koṇṭi mikaipaṭat taṇṭamiḻ ceṟittuk</l>
        <l>kuṉṟu nilaitaḷarkku murumiṟ cīṟi</l>
        <l>yorumuṟ ṟiruva rōṭṭiya voḷvāṭ</l>
        <l>cerumiku tāṉai velpō rōyē</l>
        <l>yāṭupeṟ ṟaḻinta maḷḷar māṟi</l>
        <l>nīkaṇ ṭaṉaiyē meṉṟaṉar nīyu</l>
        <l>nunnukaṅ koṇṭiṉum veṉṟōyē yataṉāṟ</l>
        <l>celvak kōvē cēralar maruka</l>
        <l>kāṟirai yeṭutta muḻaṅkukaṭal vēli</l>
        <l>naṉantalai yulakañ ceytanaṉ ṟuṇṭeṉi</l>
        <l>ṉaṭaiyaṭup paṟiyā v<hi rend="bold">aruvi yāmpa</hi> </l>
        <l>lāyira veḷḷa vūḻi</l>
        <l>vāḻi yāta vāḻiya palavē.</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

