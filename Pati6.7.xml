<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: viṟali yāṟṟuppaṭai, vaṇṇam: atu, tūkku: atu.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati6.57">
        <l>ōṭāp pūṭkai maṟavar miṭaṟapa</l>
        <l>virumpaṉam puṭaiyaloṭu vāṉkaḻal civappak</l>
        <l>kuruti paṉiṟṟum pulavukkaḷat tōṉē</l>
        <l>tuṇaṅkai yāṭiya valampaṭu kōmāṉ</l>
        <l>melliya vakuntiṟ cīṟaṭi yotuṅkic</l>
        <l>cellā mōtil <hi rend="bold">cilvaḷai viṟali</hi></l>
        <l>pāṇar kaiyatu paṇitoṭai narampiṉ</l>
        <l>viralkavar pēriyāḻ pālai paṇṇik</l>
        <l>kuralpuṇa riṉṉicait taḻiñci pāṭi</l>
        <l>yiḷantuṇaip putalvar nalvaḷam payanta</l>
        <l>vaḷaṅkeḻu kuṭaccū laṭaṅkiyakoḷkai</l>
        <l>yāṉṟa vaṟiviṟ ṟōṉṟiya nallicai</l>
        <l>yoṇṇutaṉ makaḷir tuṉitta kaṇṇiṉu</l>
        <l>miravalar puṉka ṇañcum</l>
        <l>puravetir koḷvaṉaik kaṇṭaṉam varaṟkē.</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

