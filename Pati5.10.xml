<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: vañcittuṟaip pāṭāṇpāṭṭu, vaṇṇam: oḻukuvaṇṇamum coṟcīrvaṇṇamum, tūkku: centūkku.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati5.50">
        <l>māmalai muḻakkiṉ māṉkaṇam paṉippak</l>
        <l>kāṉmayaṅku kataḻuṟai yāliyoṭu citaṟik</l>
        <l>karumpamal kaḻaṉiya nāṭuvaḷam poḻiya</l>
        <l>vaḷaṅkeḻu ciṟappi ṉulakam puraiic</l>
        <l>ceṅkuṇak koḻukuṅ kaluḻi malirniṟaik</l>
        <l>kāviri yaṉṟiyum pūviri puṉaloṭu</l>
        <l>mūṉṟuṭaṉ kūṭiya kūṭa laṉaiyai</l>
        <l>kolkaḷiṟ, ṟuravut tiraipiṟaḻa vavvil picirap</l>
        <l>puraitōl varaippi ṉeḵkumī ṉavirvara</l>
        <l>viravuppaṇai muḻaṅkoli verīiya vēntark</l>
        <l>karaṇa mākiya <hi rend="bold">veruvaru puṉaṟṟār</hi></l>
        <l>kaṉmicai yavvuṅ kaṭalavum piṟavu</l>
        <l>maruppa mamaiiya vamarkaṭan turutta</l>
        <l>vāṇmali maruṅki ṉāṭakap paṭuttu</l>
        <l>nallicai naṉantalai yiriya voṉṉā</l>
        <l>ruruppaṟa nirappiṉai yākaliṟ cāntupularpu</l>
        <l>vaṇṇa nīvi vakaivaṉap puṟṟa</l>
        <l>viriñimi ṟimiru mārpu piṇimakaḷir</l>
        <l>virimeṉ kūntaṉ mellaṇai vatintu</l>
        <l>kolpiṇi tirukiya mārpukavar muyakkattup</l>
        <l>poḻutukoṇ marapiṉ meṉpiṇi yaviḻa </l>
        <l>vevaṉpala kaḻiyumō peruma paṉṉāṭ</l>
        <l>pakaivem maiyiṟ pācaṟai marīip</l>
        <l>pāṭari tiyainta ciṟutuyi liyalātu</l>
        <l>kōṭumuḻaṅ kimiḻicai yeṭuppum</l>
        <l>pīṭukeḻu celva marīiya kaṇṇē.</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

