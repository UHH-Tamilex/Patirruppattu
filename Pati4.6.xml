<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: kaḷavaḻi, vaṇṇam: atu, tūkku: atu.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati4.36">
        <l>vīyā yāṇar niṉvayi ṉāṉē</l>
        <l>tāvā vāku malipeṟu vayavē</l>
        <l>malla luḷḷamoṭu vampamark kaṭantu</l>
        <l>cerumiku muṉpiṉ maṟavaroṭu talaicceṉṟu</l>
        <l>paṉaitaṭi puṉattiṟ kaitaṭipu palavuṭaṉ</l>
        <l>yāṉai paṭṭa <hi rend="bold">vāṇmayaṅku kaṭuntār</hi></l>
        <l>māvu mākkaḷum paṭupiṇa muṇīiyar</l>
        <l>poṟitta pōlum puḷḷi yeruttiṟ</l>
        <l>puṉpuṟa veruvaip peṭaipuṇar cēval</l>
        <l>kuṭumi yeḻāloṭu koṇṭukiḻak kiḻiya</l>
        <l>nilamiḻi nivappi ṉīṇirai palacuman</l>
        <l>turuveḻu kūḷiya ruṇṭu makiḻn tāṭak</l>
        <l>kurutic cempuṉa loḻukac</l>
        <l>ceruppala ceykuvai vāḻkaniṉ vaḷaṉē.</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

