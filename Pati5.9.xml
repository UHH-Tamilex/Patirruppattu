<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: viṟali yāṟṟuppaṭai, vaṇṇam: atu, tūkku: atu.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati5.49">
        <l>yāmuñ cēṟuka nīyirum vammiṉ </l>
        <l>ṟuyaluṅ kōtait tuḷaṅkiya viṟaliyar</l>
        <l>koḷaival vāḻkkainuṅ kiḷaiyiṉi tuṇīiyar</l>
        <l>kaḷiṟuparan tiyalak kaṭumā tāṅka </l>
        <l>voḷiṟukoṭi nuṭaṅkal tērtirintu koṭpa</l>
        <l>veḵkuturan teḻutaruṅ kaikavar kaṭuntār</l>
        <l>velpōr vēntarum vēḷiru moṉṟumoḻintu</l>
        <l>moyvaḷañ cerukki mocintuvaru mōkūr</l>
        <l>valampaṭu kuḻūunilai yatira maṇṭi</l>
        <l>neyttōr toṭṭa <hi rend="bold">ceṅkai maṟavar</hi></l>
        <l>niṟampaṭu kuruti nilampaṭarn tōṭi</l>
        <l>maḻaināṭ puṉali ṉavaṟparan toḻukap</l>
        <l>paṭupiṇam piṟaṅkap pāḻpala ceytu</l>
        <l>paṭukaṇ muraca naṭuvaṭ cilaippa</l>
        <l>vaḷaṉaṟa nikaḻntu vāḻunar palarpaṭak </l>
        <l>karuñciṉai viṟalvēm paṟutta</l>
        <l>peruñciṉak kuṭṭuvaṟ kaṇṭaṉam varaṟkē.</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

