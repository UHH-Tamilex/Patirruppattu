<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: kāṭci vāḻttu, vaṇṇam: oḻuku vaṇṇamum coṟcīr vaṇṇamum, tūkku: centūkku.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati9.82">
        <l>ikalperu maiyiṟ ṟeyvañ ceppa</l>
        <l>vāriṟai yañcā veruvaru kaṭṭūrp</l>
        <l>palkoṭi nuṭaṅku muṉpiṟ ceṟunar</l>
        <l>celcaman tolaitta <hi rend="bold">viṉainavil yāṉai</hi></l>
        <l>kaṭāam vārntu kaṭuñciṉam potti</l>
        <l>vaṇṭupaṭu ceṉṉiya piṭipuṇarn tiyala</l>
        <l>maṟavar maṟala māppaṭai yuṟuppat</l>
        <l>tērkoṭi nuṭaṅkat tōlpuṭai yārppak</l>
        <l>kāṭukai kāyttiya nīṭunā ḷirukkai</l>
        <l>yiṉṉa vaikal paṉṉā ḷākap</l>
        <l>pāṭik kāṇku vanticiṟ peruma </l>
        <l>pāṭu nar, koḷakkoḷak kuṟaiyāc celvattuc ceṟṟōr</l>
        <l>kolakkolak kuṟaiyāt tāṉaic cāṉṟōr</l>
        <l>vaṇmaiyuñ cemmaiyuñ cālpu maṟaṉum</l>
        <l>pukaḻntupukaṉ ṟacaiyā nallicai</l>
        <l>nilantaru tiruvi ṉeṭiyōy niṉṉē.</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

