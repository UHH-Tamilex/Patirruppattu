<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: pariciṟṟuṟaip pāṭāṇpāṭṭu, vaṇṇam: atu, tūkku: atu.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati7.65">
        <l>eṟipiṇa miṭaṟiya cemmaṟuk kuḷampiṟ</l>
        <l>pariyuṭai naṉmā viriyuḷai cūṭṭi</l>
        <l>malaitta tevvar maṟantapak kaṭantu</l>
        <l>kāñci cāṉṟa vayavar peruma</l>
        <l>villōr meymmaṟai cērntōr celva</l>
        <l>pūṇaṇin teḻiliya vaṉaintuvara liḷamulai</l>
        <l>māṇvari yalkul malarnta nōkkiṉ</l>
        <l>vēypurai peḻiliya viḷaṅkiṟaip paṇaittōṭ</l>
        <l>kāmar kaṭavuḷu māḷuṅ kaṟpiṟ </l>
        <l>cēṇāṟu naṟunutaṟ cēyiḻai kaṇava</l>
        <l>pāṇar puravala paricilar veṟukkai</l>
        <l>pūṇaṇintu viḷaṅkiya pukaḻcāṉ mārpaniṉ</l>
        <l><hi rend="bold">ṉāṇmaki ḻirukkai</hi> yiṉitukaṇ ṭikumē </l>
        <l>tīntoṭai narampiṉ pālai vallōṉ </l>
        <l>paiyu ḷuṟuppiṟ paṇṇup peyarttāṅkuc</l>
        <l>cēṟucey māriyi ṉaḷikkuniṉ</l>
        <l>cāṟupaṭu tiruvi ṉaṉaimaki ḻāṉē.</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

