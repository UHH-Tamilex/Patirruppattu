<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: uḻiñai yaravam, vaṇṇam: atu, tūkku: atu.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati8.77">
        <l>eṉaipperum paṭaiyaṉō ciṉappōrp poṟaiya</l>
        <l>ṉeṉṟaṉi rāyiṉu māṟucel vampalir</l>
        <l>maṉpatai peyara varacukaḷat toḻiyak</l>
        <l>koṉṟutō ḷōcciya <hi rend="bold">veṉṟāṭu tuṇaṅkai</hi></l>
        <l>mīpiṇat turuṇṭa tēyā vāḻiyiṟ</l>
        <l>paṇṇamai tēru māvu mākkaḷu </l>
        <l>meṇṇaṟ karumaiyi ṉeṇṇiṉṟō vilaṉē</l>
        <l>kantukō ḷīyātu kāḻpala murukki</l>
        <l>yukakkum parunti ṉilattuniḻal cāṭic</l>
        <l>cēṇparaṉ murampi ṉīrmpaṭaik koṅka</l>
        <l>rāparan taṉṉa celaviṟpal </l>
        <l>yāṉai kāṇpalavaṉ ṟāṉai yāṉē.</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

