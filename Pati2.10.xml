<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: iyaṉmoḻi vāḻttu, vaṇṇam: oḻukuvaṇṇamum coṟcīr vaṇṇamum, tūkku: centūkkum vañcittūkkum.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati2.20">
        <l>nuṅkō yāreṉa viṉavi ṉeṅkō</l>
        <l>virumunnīrt turuttiyuḷ</l>
        <l>muraṇiyōrt talaicceṉṟu</l>
        <l>kaṭampu muta ṟaṭinta kaṭuñciṉa muṉpi</l>
        <l>ṉeṭuñcēra lātaṉ vāḻkavavaṉ kaṇṇi</l>
        <l>vāyppaṟi yalaṉē veyiṟṟuka ḷaṉaittum</l>
        <l>māṟṟōr tēettu māṟiya viṉaiyē</l>
        <l>kaṇṇi ṉuvantu neñcaviḻ paṟiyā</l>
        <l>naṇṇār tēettum poyppaṟi yalaṉe</l>
        <l>kaṉaviṉumoṉ ṉārtēya vōṅki naṭantu</l>
        <l>paṭiyōrt tēettu vaṭimaṇi yiraṭṭuṅ</l>
        <l>kaṭāa yāṉaik kaṇanirai yalaṟa</l>
        <l>viyalirum parappiṉ mānilaṅ kaṭantu</l>
        <l>pulava rētta vōṅkupukaḻ niṟīi</l>
        <l>viriyuḷai māvuṅ kaḷiṟun tērum</l>
        <l>vayiriyar kaṇṇuḷark kōmpātu vīcik </l>
        <l>kaṭimiḷaik kuṇṭu kiṭaṅki</l>
        <l>ṉeṭumati ṉilai ñāyi</l>
        <l>lampuṭai yāreyi luḷḷaḻit tuṇṭa</l>
        <l>vaṭāa vaṭupukai <hi rend="bold">yaṭṭumalar mārpa</hi></l>
        <l>ṉemarkkum piṟarkkum yāva rāyiṉum</l>
        <l>pariciṉ mākkaḷ vallā rāyiṉum</l>
        <l>koṭaikkaṭa ṉamarnta kōṭā neñciṉaṉ</l>
        <l>maṉṉuyi raḻiya yāṇṭupala māṟit</l>
        <l>taṇṇiya leḻili talaiyā tāyiṉum</l>
        <l>vayiṟupaci kūra vīyalaṉ</l>
        <l>vayiṟumā cilīyarava ṉīṉṟa tāyē</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>
