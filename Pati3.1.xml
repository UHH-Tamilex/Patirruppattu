<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: centuṟaip pāṭāṇpāṭṭu, vaṇṇam: oḻukuvaṇṇam, tūkku: centūkku.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati3.21">
       <l>coṟpeyar nāṭṭaṅ kēḷvi neñcameṉ</l>
	     <l>ṟaintuṭaṉ pōṟṟi yavaituṇai yāka</l>
	     <l>vevvañ cūḻātu viḷaṅkiya koḷkaik</l>
	     <l>kālai yaṉṉa cīrcāl vāymoḻi</l>
	     <l>yurukeḻu marapiṟ kaṭavuṭ pēṇiyar</l>
	     <l>koṇṭa tīyiṉ cuṭareḻu tōṟum</l>
	     <l>virumpumey paranta perumpeya rāvuti</l>
	     <l>varunar varaiyār vāra vēṇṭi</l>
	     <l>viruntukaṇ māṟā tuṇīiya pācava</l>
	     <l>rūuṉat taḻitta vāṉiṇak koḻuṅkuṟai</l>
       <l>kuyyiṭu tōṟu māṉā tārppak</l>
	     <l>kaṭaloli koṇṭa ceḻunakar varaippiṉ </l>
	     <l>naṭuva ṇeḻunta <hi rend="bold">vaṭuney yāvuti</hi></l>
	     <l>yiraṇṭuṭaṉ kamaḻu nāṟṟamoṭu vāṉattu		</l>
	     <l>nilaipeṟu kaṭavuḷum viḻaitakap pēṇi</l>
	     <l>yārvaḷam paḻuniya vaiyantīr ciṟappiṉ</l>
	     <l>māriyaṅ kaḷḷiṉ pōrval yāṉaip</l>
	     <l>pōrppuṟu muracaṅ kaṟaṅka vārppucciṟantu </l>
	     <l>naṉkalan tarūu maṇpaṭu mārpa</l>
	     <l>mullaik kaṇṇip pallāṉ kōvalar</l>
       <l>pulluṭai viyaṉpulam pallā parappik</l>
	     <l>kalluyar kaṭattiṭaik katirmaṇi peṟūu</l>
	     <l>mitiyaṟ ceruppiṟ pūḻiyar kōvē</l>
	     <l>kuviyaṟ kaṇṇi maḻavar meymmaṟai</l>
	     <l>palpayan taḻīiya payaṅkeḻu neṭuṅkōṭṭu</l>
	     <l>nīraṟaṉ maruṅku vaḻippaṭāp pākuṭip</l>
	     <l>pārvaṟ kokkiṉ parivēṭ pañcāc</l>
	     <l>cīruṭait tēetta muṉaikeṭa vilaṅkiya</l>
	     <l>nēruyar neṭuvarai yayiraip poruna</l>
	     <l>yāṇṭupiḻaip paṟiyātu payamaḻai curantu</l>
       <l>nōyiṉ māntark kūḻi yāka </l>
	     <l>maṇṇā vāyiṉ maṇaṅkamaḻ koṇṭu</l>
	     <l>kārmalar kamaḻun tāḻiruṅ kūnta</l>
	     <l>lorīiyiṉa pōla viravumalar niṉṟu</l>
	     <l>tirumukat talamarum perumatar maḻaikka</l>
	     <l>ṇalaṅkiya kānta ḷilaṅkunī raḻuvattu</l>
	     <l>vēyuṟaḻ paṇaittō ḷivaḷō</l>
	     <l>ṭāyira veḷḷam vāḻiya palavē</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

