<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: vākaittuṟaip pāṭāṇpāṭṭu, vaṇṇam: atu, tūkku: centūkku.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati4.35">
        <l>puraicāṉ mainta nīyōmpaṉ māṟē</l>
        <l>yuraicāṉ ṟaṉavāṟ perumaniṉ veṉṟi</l>
        <l>yiruṅkaḷiṟ ṟiyāṉai yilaṅkuvāṇ maruppoṭu</l>
        <l>neṭuntērt tikiri tāya viyaṉkaḷat</l>
        <l>taḷakuṭaic cēvaṟ kiḷaipukā vārat</l>
        <l>talaitumin teñciya <hi rend="bold">meyyāṭu paṟantalai</hi></l>
        <l>yanti mālai vicumpukaṇ ṭaṉṉa</l>
        <l>ceñcuṭar koṇṭa kuruti maṉṟattup</l>
        <l>pēe yāṭum velpōr</l>
        <l>vīyā yāṇar niṉvayi ṉāṉē.</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

