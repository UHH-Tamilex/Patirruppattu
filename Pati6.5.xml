<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: centuṟaip pāṭāṇpāṭṭu, vaṇṇam: atu, tūkku: atu.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati6.55">
        <l>āṉṟōḷ kaṇava cāṉṟōr puravala</l>
        <l>niṉṉayantu vantaṉe ṉaṭupōrk koṟṟava</l>
        <l>viṉṉicaip puṇari yiraṅkum pauvattu</l>
        <l>naṉkala veṟukkai <hi rend="bold">tuñcum pantar</hi>k </l>
        <l>kamaḻun tāḻaik kāṉalam peruntuṟait</l>
        <l>taṇkaṭaṟ paṭappai naṉṉāṭṭup poruna</l>
        <l>cevvūṉ ṟōṉṟā veṇṭuvai mutirai</l>
        <l>vālūṉ valci maḻavar meymmaṟai </l>
        <l>kuṭavar kōvē koṭittē raṇṇal </l>
        <l>vārā rāyiṉu miravalar vēṇṭit</l>
        <l>tēriṟ ṟantavark kārpata ṉalku</l>
        <l>nacaicāl vāymoḻi yicaicā ṟōṉṟal</l>
        <l>vēṇṭuva vaḷavaiyuḷ yāṇṭupala kaḻiyap</l>
        <l>peytupuṟan tantu poṅka lāṭi</l>
        <l>viṇṭuc cērnta veṇmaḻai pōlac</l>
        <l>ceṉṟā liyarō peruma valkalu</l>
        <l>naṉantalai vēntar tāraḻin talaṟa</l>
        <l>neṭuvarai yaṭukkatta nāṭukaik koṇṭu</l>
        <l>porutu ciṉantaṇinta ceruppuka lāṇmait</l>
        <l>tāṅkunart takaitta voḷvā</l>
        <l>ḷōṅka luḷḷattuk kuruciṉiṉ ṉāḷē.</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

