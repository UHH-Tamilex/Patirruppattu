<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: centuṟaip pāṭāṇpāṭṭu, vaṇṇam: atu, tūkku: atu.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati5.42">
        <l>irumpaṉam puṭaiya līkai vāṉkaḻaṉ</l>
        <l>mīṉṟēr koṭpiṟ paṉikkaya mūḻkic</l>
        <l>ciral peyarn taṉṉa neṭuveḷ ḷūci</l>
        <l>neṭuvaci paranta vaṭuvāḻ mārpi</l>
        <l>ṉampucē ruṭampiṉarc cērntō rallatu</l>
        <l>tumpai cūṭātu malainta māṭci</l>
        <l>yaṉṉōr peruma naṉṉutal kaṇava</l>
        <l>vaṇṇal yāṉai yaṭupōrk kuṭṭuva</l>
        <l>maintuṭai nallamark kaṭantu valantarīi</l>
        <l>yiñcivī virāya paintār pūṭṭic</l>
        <l>cāntupuṟat teṟinta <hi rend="bold">tacumputuḷaṅ kirukkai</hi>t</l>
        <l>tīñcēṟu viḷainta maṇiniṟa maṭṭa</l>
        <l>mōmpā vīkaiyiṉ maṉamakiḻ curantu</l>
        <l>kōṭiyar peruṅkiḷai vāḻa vāṭiya</l>
        <l>luḷaiyavir kalimāp poḻintavai yeṇṇiṉ</l>
        <l>maṉpatai maruḷa varacupaṭak kaṭantu</l>
        <l>muntuviṉai yetirvarap peṟutal kāṇiya</l>
        <l>roḷiṟunilai yuyar marup pēntiya kaḷiṟūrntu</l>
        <l>māṉa maintaroṭu maṉṉa rēttaniṉ</l>
        <l>ṟēroṭu cuṟṟa mulakuṭaṉ mūya</l>
        <l>māyirun teṇkaṭaṉ maliniraip pauvattu</l>
        <l>veṇṭalaik kurūuppici ruṭaiyat</l>
        <l>taṇpala varūum puṇariyiṟ palavē.</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

