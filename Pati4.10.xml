<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: viṟali yāṟṟuppaṭai, vaṇṇam: atu, tūkku: atu.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati4.40">
        <l>pōrniḻaṟ pukaṉṟa cuṟṟamo ṭūrmukat</l>
        <l>tiṟāa liyarō perumaniṉ ṟāṉai</l>
        <l>yiṉṉicai yimiḻmura ciyampak kaṭippikūup</l>
        <l>puṇṭō ḷāṭavar pōrmukat tiṟuppak</l>
        <l>kāytta karantai mākkoṭi viḷaivayal</l>
        <l>vantiṟai koṇṭaṉṟu tāṉai yantiṟ</l>
        <l>kaḷainar yāriṉip piṟareṉap pēṇi</l>
        <l>maṉṉeyiṉ maṟava roliyavin taṭaṅka</l>
        <l>voṉṉār tēyap pūmalain turaii</l>
        <l>vaṇṭōṭu niraitta vēntuṭai yaruñcamaṅ</l>
        <l>koṉṟupuṟam peṟṟu maṉpatai nirappi</l>
        <l>veṉṟi yāṭiya toṭittōṇ mīkai</l>
        <l>yeḻumuṭi keḻīiya tiruñema rakalattup </l>
        <l>poṉṉaṅ kaṇṇip polantēr naṉṉaṉ</l>
        <l>cuṭarvī vākaik kaṭimuta ṟaṭinta</l>
        <l>tārmiku mainti ṉārmuṭic cēral</l>
        <l>puṉkā luṉṉañ cāyat teṇkaṇ</l>
        <l>vaṟitukūṭ ṭariya liravalart taṭuppat</l>
        <l>tāṉṟara vuṇṭa naṉainaṟavu makiḻntu</l>
        <l>nīrimiḻ cilampi ṉēri yōṉē</l>
        <l>cellā mōtil cilvaḷai viṟali</l>
        <l>malarnta vēṅkaiyiṉ vayaṅkiḻai yaṇintu</l>
        <l>melliyaṉ makaḷi reḻiṉalañ ciṟappap</l>
        <l>pāṇar paimpū malaiya viḷaiya</l>
        <l>riṉkaḷi vaḻāa meṉco lamarntu</l>
        <l>neñcumali yuvakaiyar viyaṉkaḷam vāḻttat</l>
        <l>tōṭṭi nivantu toṭicērpu niṉṟu</l>
        <l>pāka rēvali ṉoṇpoṟi picirak</l>
        <l>kāṭutalaik koṇṭa <hi rend="bold">kāṭukā ṇavircuṭa</hi></l>
        <l>raḻalviṭupu marīiya maintiṟ</l>
        <l>ṟoḻilpukal yāṉai nalkuvaṉ palavē.</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

