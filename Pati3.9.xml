<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: vañcittuṟaip pāṭāṇpāṭṭu, vaṇṇam: atu, tūkku: atu.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati3.29">
        <l>avaleṟi vulakkai vāḻaic cērtti</l>
        <l>vaḷaikkai makaḷir vaḷḷai koyyu</l>
        <l>muṭantai nelliṉ viḷaivayaṟ paranta</l>
        <l>taṭantā ṇārai yiriya vayiraik</l>
        <l>koḻumī ṉārkaiya marantoṟuṅ kuḻāaliṉ</l>
        <l><hi rend="bold">veṇkai makaḷir</hi> veṇkuru kōppu</l>
        <l>maḻiyā viḻavi ṉiḻiyāt tivaviṉ</l>
        <l>vayiriyar mākkaḷ paṇṇamait teḻīi</l>
        <l>maṉṟa naṇṇi maṟuku ciṟaipāṭu</l>
        <l>makaṉkaṇ vaippi ṉāṭuma ṉaḷiya</l>
        <l>viravuvēṟu kūlamoṭu kuruti vaṭṭa</l>
        <l>mayirputai mākkaṇ kaṭiya kaḻaṟa</l>
        <l>vamarkō ṇērikan tāreyil kaṭakkum</l>
        <l>perumpal yāṉaik kuṭṭuvaṉ</l>
        <l>varampi ṟāṉai paravā vāṅkē.</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

