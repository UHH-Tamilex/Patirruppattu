<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: nāṭu vāḻttu, vaṇṇam: atu, tūkku: atu.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati3.28">
        <l>tiruvuṭait tamma peruviṟaṟ pakaivar</l>
        <l>paiṅkaṇ yāṉaip puṇarnirai tumiya</l>
        <l>vuranturan teṟinta kaṟaiyaṭik kaḻaṟkāṟ</l>
        <l>kaṭumā maṟavar kataḻtoṭai maṟappa</l>
        <l>viḷaiyiṉitu tantu viḷaivumuṭ ṭuṟātu</l>
        <l>pulampā vuṟaiyu ṇītoḻi lāṟṟaliṉ</l>
        <l>viṭunilak karampai viṭaraḷai niṟaiyak</l>
        <l>kōṭai nīṭak kuṉṟam pulleṉa</l>
        <l>varuvi yaṟṟa peruvaṟaṟ kālaiyu</l>
        <l>nivantukarai yiḻitaru naṉantalaip pēriyāṟṟuc</l>
        <l>cīruṭai viyaṉpulam vāyparantu mikīiya</l>
        <l>ruvalai cūṭi <hi rend="bold">yuruttuvaru malirniṟaic</hi></l>
        <l>cennīrp pūca lallatu</l>
        <l>vemmai yarituniṉ ṉakaṉṟalai nāṭē.</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

