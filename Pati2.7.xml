<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: centuṟaip pāṭāṇ pāṭṭu, vaṇṇam: oḻuku vaṇṇam, tūkku: centūkku.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati2.17">
        <l>puraivatu niṉaippiṟ puraivatō viṉṟē </l>
        <l>periya tappuna rāyiṉum pakaivar</l>
        <l>paṇintutiṟai pakarak koḷḷunai yākaliṟ </l>
        <l>ṟuḷaṅkupici ruṭaiya mākkaṭa ṉīkki</l>
        <l>kaṭampaṟut tiyaṟṟiya <hi rend="bold">valampaṭu viyaṉpaṇai</hi></l>
        <l>yāṭunar peyarntuvan tarumpali tūuyk</l>
        <l>kaṭippuk kaṇṇuṟūun toṭittō ḷiyava</l>
        <l>raraṇaṅ kāṇātu mātiran tuḻaiiya</l>
        <l>naṉantalaip paiññilam varukavin niḻaleṉa</l>
        <l>ñāyiṟu pukaṉṟa tītutīr ciṟappi</l>
        <l>ṉamiḻtutikaḻ karuviya kaṇamaḻai talaiik</l>
        <l>kaṭuṅkāl koṭku naṉperum parappiṉ</l>
        <l>vicumputōy veṇkuṭai nuvalum</l>
        <l>pacumpūṇ mārpa pāṭiṉi vēntē</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>
