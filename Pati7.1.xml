<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: kāṭci vāḻttu, vaṇṇam: oḻuku vaṇṇam, tūkku: centūkku.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati7.61">
        <l>palāam paḻutta pacumpuṇ ṇariyal </l>
        <l>vāṭai tūkku nāṭukeḻu peruviṟa</l>
        <l>lōvat taṉṉa viṉaipuṉai nalliṟ</l>
        <l>pāvai yaṉṉa nallōḷ kaṇavaṉ</l>
        <l>poṉṉi ṉaṉṉa pūviṟ ciṟiyilaip</l>
        <l>puṉkā luṉṉattup pakaiva ṉeṅkō</l>
        <l>pularnta cāntiṟ pularā vīkai</l>
        <l>malarnta mārpiṉ māvaṇ pāri </l>
        <l>muḻavumaṇ pulara viravala riṉaiya</l>
        <l>vārāc cēṭpulam paṭarntō ṉaḷikkeṉa</l>
        <l>virakku vārē ṉeñcik kūṟē</l>
        <l>ṉīttataṟ kiraṅkā ṉīttoṟu makiḻā</l>
        <l>ṉīttoṟu māvaḷ ḷiyaṉeṉa nuvaluniṉ</l>
        <l>ṉallicai taravan ticiṉē yoḷvā</l>
        <l>ḷuravuk kaḷiṟṟup <hi rend="bold">pulāam pācaṟai</hi></l>
        <l>nilavi ṉaṉṉa veḷvēl pāṭiṉi</l>
        <l>muḻaviṟ pōkkiya vaṇkai </l>
        <l>viḻavi ṉaṉṉaniṉ kalimaki ḻāṉē.</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

