<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: centuṟaip pāṭāṇpāṭṭu, vaṇṇam: atu, tūkku: atu.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati9.86">
        <l>uṟaluṟu kurutic cerukkaḷam pulavak</l>
        <l>koṉṟamark kaṭanta <hi rend="bold">ventiṟaṟ ṟaṭakkai</hi></l>
        <l>veṉvēṟ poṟaiya ṉeṉṟaliṉ veruvara</l>
        <l>veppuṭai yāṭūuc cettaṉeṉ maṉyā</l>
        <l>ṉallicai nilaiiya naṉantalai yulakat</l>
        <l>tillōr puṇkaṇ ṭīra nalku</l>
        <l>nāṭal cāṉṟa nayaṉuṭai neñciṟ</l>
        <l>pāṭunar puravala ṉāṭunaṭai yaṇṇal</l>
        <l>kaḻainilai peṟāak kuṭṭat tāyiṉum</l>
        <l>puṉalpāy makaḷi rāṭa voḻinta</l>
        <l>poṉcey pūṅkuḻai mīmicait tōṉṟuñ</l>
        <l>cāntuvaru vāṉi nīriṉun</l>
        <l>tīntaṇ cāyalaṉ maṉṟa tāṉē.</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

