<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: vañcittuṟaip pāṭāṇpāṭṭu, vaṇṇam: oḻukuvaṇṇam, tūkku: centūkkum vañcittūkkum.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati4.33">
        <l>iṟumpūtāṟ peritē koṭittē raṇṇal</l>
        <l>vaṭimaṇi yaṇaitta paṇaimaru ṇōṉṟāṭ</l>
        <l>kaṭimarattāṟ kaḷiṟaṇaittu</l>
        <l>neṭunīra tuṟaikalaṅka</l>
        <l>mūḻttiṟutta viyaṉṟāṉaiyoṭu</l>
        <l>pulaṅkeṭa neritarum <hi rend="bold">varampil veḷḷam</hi></l>
        <l>vāṇmati lāka vēṉmiḷai yuyarttu</l>
        <l>vilvicai yumiḻnta vaimmuḷ ḷampiṟ</l>
        <l>cevvā yeḵkam vaḷaiiya vakaḻiṟ</l>
        <l>kāriṭi yurumi ṉuraṟu muraciṟ</l>
        <l>kālvalaṅ kāreyil karutiṟ</l>
        <l>pōretir vēnta rorūupa niṉṉē.</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

