<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: vākai, vaṇṇam: atu, tūkku: atu.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati4.39">
        <l>piṟarkkeṉa vāḻkanī yākaṉ māṟē</l>
        <l>yemakkileṉ ṉārniṉ maṟaṅkūṟu kuḻāttar</l>
        <l>tupputtuṟai pōkiya veppuṭait tumpaik</l>
        <l>kaṟutta tevvar kaṭimuṉai yalaṟa</l>
        <l>veṭutteṟin tiraṅku m<hi rend="bold">ēval viyaṉpaṇai</hi></l>
        <l>yurumeṉa vatirpaṭṭu muḻaṅkic cerumik</l>
        <l>kaṭaṅkā rāraraṇ vāṭac celluṅ</l>
        <l>kāla ṉaṉaiya kaṭuñciṉa muṉpa</l>
        <l>vāliti, ṉūli ṉiḻaiyā nuṇmayi riḻaiya</l>
        <l>poṟitta pōlum puḷḷi yeruttiṟ</l>
        <l>puṉpuṟap puṟaviṉ kaṇanirai yalaṟa</l>
        <l>valantalai vēlat tulavai yañciṉaic</l>
        <l>cilampi kōliya valaṅkaṟ pōrvaiyi</l>
        <l>ṉilaṅkumaṇi miṭainta pacumpoṟ paṭalat</l>
        <l>taviriḻai taii miṉṉumiḻ pilaṅkac</l>
        <l>cīrmiku muttan taiiya</l>
        <l>nārmuṭic cēraniṉ pōrniḻaṟ pukaṉṟē.</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

