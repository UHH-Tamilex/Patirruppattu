<text xml:lang="ta" type="edition">
  <body>
    <div rend="parallel">
      <lg xml:id="Pati5.51">
        <l>vaṭava ruṭkum vāṉṟōy velkoṭik</l>
        <l>kuṭavar kōmā ṉeṭuñcēra lātaṟkuc</l>
        <l>cōḻaṉ maṇakkiḷḷi yīṉṟa makaṉ</l>
        <l>kaṭavuṭ pattiṉik kaṟkōḷ vēṇṭik </l>
        <l>kāṉavil kāṉaṅ kaṇaiyiṟ pōki</l>
        <l>yāriya vaṇṇalai vīṭṭip pēricai</l>
        <l>yiṉpa laruvik kaṅkai maṇṇi</l>
        <l>yiṉanteri pallāṉ kaṉṟoṭu koṇṭu</l>
        <l>māṟā valvi liṭumpiṟ puṟattiṟut</l>
        <l>tuṟupuli yaṉṉa vayavar vīḻac</l>
        <l>ciṟukura ṉeytal viyalūr nūṟi</l>
        <l>yakkarai naṇṇik koṭukū reṟintu</l>
        <l>paḻaiyaṉ kākkuṅ karuñciṉai vēmpiṉ</l>
        <l>muḻārai muḻumuta ṟumiyap paṇṇi</l>
        <l>vāliḻai kaḻitta naṟumpal peṇṭir</l>
        <l>palliruṅ kūntaṉ muraṟciyāṟ</l>
        <l>kuñcara voḻukai pūṭṭi ventiṟa</l>
        <l>lārāc ceruviṟ cōḻar kuṭikkuriyō</l>
        <l>roṉpatiṉmar vīḻa vāyiṟpuṟat tiṟuttu</l>
        <l>nilaicceruvi ṉāṟṟalai yaṟuttuk</l>
        <l>keṭalarun tāṉaiyoṭu</l>
        <l><persName>kaṭalpiṟak kōṭṭiya ceṅkuṭ ṭuvaṉ</persName>aik</l>
        <l>karaṇa mamainta kācaṟu ceyyuṭ</l>
        <l>paraṇar pāṭiṉār pattup pāṭṭu.</l>
      </lg>
      <lg xml:lang="en">
        <l>translation line</l>
        <l>translation line</l>
      </lg>
    </div>

    <div rend="parallel">
    <p xml:id="Pati5.51coda1">
      avai tām: cuṭarvī vēṅkai, tacumpu tuḷaṅkirukkai, ēṟāvēṇi, nōytapu nōṉṟoṭai, ūṉṟuvai yaṭicil, karaivāyp paruti, naṉṉutal viṟaliyar, pēreḻil vāḻkkai, ceṅkai maṟavar, veruvaru puṉaṟṟār ivai pāṭṭiṉ patikam.
     </p>
     <p xml:lang="en">translation</p>
    </div>
    
    <div rend="parallel">
     <p xml:id="Pati5.51coda2">
      pāṭip peṟṟa paricil: umpaṟkāṭṭu vāriyaiyum taṉ makaṉ kuṭṭuvaṉcēra laiyuṅ koṭuttāṉ akkō. kaṭalpiṟakkōṭṭiya ceṅkuṭṭuvaṉ aimpattaiyāṇṭu vīṟṟiruntāṉ.
     </p>
     <p xml:lang="en">translation</p>
    </div>
  </body>
</text>

