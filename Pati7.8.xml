<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: centuṟaip pāṭāṇpāṭṭu, vaṇṇam: atu, tūkku: atu.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati7.68">
        <l>kālkaṭip pākak kaṭalolit tāṅku</l>
        <l>vēṟupulat tiṟutta kaṭṭūr nāppaṭ </l>
        <l>kaṭuñcilai kaṭavun taḻaṅku kuraṉmuraca</l>
        <l>makaliru vicumpi ṉākat tatira</l>
        <l>vevvari nilaiiya veyileṟin talla </l>
        <l>tuṇṇā taṭukkiya poḻutupala kaḻiya</l>
        <l>neñcupuka lūkkattar meytayaṅ kuyakkat</l>
        <l>tiṉṉā ruṟaiyuṭ ṭāmpeṟi ṉallatu</l>
        <l>vēntūr yāṉai veṇkōṭu koṇṭu</l>
        <l>kaṭkoṭi nuṭaṅku māvaṇam pukkuṭa</l>
        <l>ṉaruṅka ṇoṭaimai tīrntapiṉ makiḻciṟantu</l>
        <l>nāma maṟiyā v<hi rend="bold">ēma vāḻkkai</hi> </l>
        <l>vaṭapula vāḻnariṟ peritamarn talkalu</l>
        <l>miṉṉakai mēya palluṟai peṟupakol </l>
        <l>pāya liṉmaiyiṟ pāciḻai ñekiḻa</l>
        <l>neṭuma ṇiñci nīṇakar varaippi</l>
        <l>ṉōvuṟaḻ neṭuñcuvar nāḷpala veḻutic</l>
        <l>cevviral civanta vavvarik kuṭaccū</l>
        <l>laṇaṅkeḻi larivaiyarp piṇikku</l>
        <l>maṇaṅkamaḻ mārpaniṉ ṟāṇiḻa lōrē.</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

