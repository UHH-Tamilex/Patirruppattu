<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: centuṟaip pāṭāṇpāṭṭu, vaṇṇam: oḻukuvaṇṇam, tūkku: centūkku.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati8.75">
        <l>irumpuli koṉṟu peruṅkaḷi ṟaṭūu</l>
        <l>maruppoṟi vayamā vaṉaiya palvēṟ</l>
        <l>polantār yāṉai yiyaṟērp poṟaiya</l>
        <l>vēntarum vēḷirum piṟarum kīḻppaṇintu</l>
        <l>niṉvaḻip paṭāa rāyi ṉeṉmik</l>
        <l>kaṟaiyuṟu karumpiṉ <hi rend="bold">ṟīñcēṟṟi yāṇar</hi></l>
        <l>varunar varaiyā vaḷamīṅ kirukkai</l>
        <l>vaṉpulan taḻīiya meṉpā ṟōṟu</l>
        <l>marumpaṟai viṉaiñar pullikal paṭuttuk</l>
        <l>kaḷḷuṭai niyamat toḷvilai koṭukkum</l>
        <l>veḷvara kuḻuta kalluṭaik karampaic</l>
        <l>cennel valci yaṟiyār tattam </l>
        <l>pāṭal cāṉṟa vaippi</l>
        <l>ṉāṭuṭa ṉāṭal yāvaṇa tavarkkē.</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

