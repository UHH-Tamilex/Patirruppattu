<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: centuṟaip pāṭāṇpāṭṭu, vaṇṇam: atu, tūkku: atu.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati9.85">
        <l>naṉmaran tuvaṉṟiya nāṭupala tarīip</l>
        <l>poṉṉavir puṉaiceya lilaṅkum perumpū</l>
        <l>ṇoṉṉāp pūṭkaic ceṉṉiyar perumā</l>
        <l>ṉiṭṭa veḷvēṉ muttait tammeṉa</l>
        <l>muṉṟiṇai mutalvar pōla niṉṟu</l>
        <l>tīñcuṉai nilaiiya tirumā maruṅkiṟ</l>
        <l>kōṭupala virinta <hi rend="bold">nāṭukā ṇeṭuvarai</hi>c</l>
        <l>cūṭā naṟavi ṉāṇmaki ḻirukkai</l>
        <l>yaracavai paṇiya vaṟampurintu vayaṅkiya</l>
        <l>maṟampuri koḷkai vayaṅkucen nāvi</l>
        <l>ṉuvalai kūrāk kavalaiyi ṉeñci</l>
        <l>ṉaṉaviṟ pāṭiya nallicaik</l>
        <l>kapilaṉ peṟṟa vūriṉum palavē.</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

