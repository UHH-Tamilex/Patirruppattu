<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: centuṟaip pāṭāṇpāṭṭu, vaṇṇam: atu, tūkku: atu.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati6.59">
        <l>pakaṉīṭā tiravup poḻutu peruki</l>
        <l>māci niṉṟa <hi rend="bold">mākūr tiṅkaṭ</hi></l>
        <l>paṉiccuram paṭarum pāṇmaka ṉuvappap</l>
        <l>pulliruḷ viṭiyap pulampucē ṇakalap</l>
        <l>pāyiru ṇīṅkap palkatir parappi</l>
        <l>ñāyiṟu kuṇamutaṟ ṟōṉṟi yāaṅ</l>
        <l>kiravaṉ mākkaḷ ciṟukuṭi peruka</l>
        <l>vulakan tāṅkiya mēmpaṭu kaṟpiṉ</l>
        <l>villōr meymmaṟai vīṟṟiruṅ koṟṟattuc</l>
        <l>celvar celva cērntōrk karaṇa</l>
        <l>maṟiyā tetirntu tuppiṟ kuṟaiyuṟṟup</l>
        <l>paṇintutiṟai tarupaniṉ pakaiva rāyiṟ</l>
        <l>ciṉañcelat taṇiyumō vāḻkaniṉ kaṇṇi</l>
        <l>palvēṟu vakaiya naṉantalai yīṇṭiya</l>
        <l>malaiyavuṅ kaṭalavum paṇṇiyam pakukku</l>
        <l>māṟumuṭ ṭuṟāa taṟampurin toḻuku</l>
        <l>nāṭal cāṉṟa tuppiṟ paṇaittōṭ</l>
        <l>pāṭucā ṉaṉkalan tarūu</l>
        <l>nāṭupuṟan taruka ṉiṉakkumār kaṭaṉē.</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

