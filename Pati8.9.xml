<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: centuṟaippāṭāṇpāṭṭu, vaṇṇam: atu, tūkku: atu.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati8.79">
        <l>uyirpōṟ ṟalaiyē ceruvat tāṉē </l>
        <l>koṭaipōṟ ṟalaiyē yiravalar naṭuvaṇ</l>
        <l>periyōrp pēṇi ciṟiyōrai yaḷitti </l>
        <l>niṉvayiṟ piṟanta nallicai kaṉaviṉum </l>
        <l>piṟanacai yaṟiyā vayaṅkucen nāviṟ</l>
        <l>paṭiyōrt tēytta vāṇmai toṭiyōr</l>
        <l>tōḷiṭaik kuḻainta kōtai mārpa</l>
        <l>vaṉaiyai vaḷapparuṅ kuraiyai yataṉā</l>
        <l>ṉiṉṉoṭu vārār tannilat toḻintu </l>
        <l>kolkaḷiṟ ṟiyāṉai yeruttam pulleṉa</l>
        <l>vilkulai yaṟuttuk kōliṉ vārā</l>
        <l>velpōr vēntar muracukaṇ pōḻntava</l>
        <l>raracuvā vaḻaippak kōṭaṟut tiyaṟṟiya</l>
        <l>vaṇaṅkuṭai marapiṟ kaṭṭiṉ mēliruntu</l>
        <l>tumpai cāṉṟa meytayaṅ kuyakkattu</l>
        <l><hi rend="bold">niṟampaṭu kuruti</hi> puṟampaṭi ṉallatu</l>
        <l>maṭaiyetir koḷḷā vañcuvaru marapiṟ</l>
        <l>kaṭavu ḷayiraiyi ṉilaiik</l>
        <l>kēṭila vāka perumaniṉ pukaḻē.</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

