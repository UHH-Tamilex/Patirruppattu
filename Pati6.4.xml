<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: kāṭci vāḻttu, vaṇṇam: atu, tūkku: atu.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati6.54">
        <l>vaḷḷiyai yeṉṟaliṟ kāṇkuvan ticiṉē</l>
        <l>yuḷḷiyatu muṭitti vāḻkaniṉ kaṇṇi </l>
        <l>vīṅkiṟait taṭaiiya vamaimaruḷ paṇaittō</l>
        <l>ḷēnteḻiṉ maḻaikkaṇ vaṉaintuvara liḷamulaip</l>
        <l>pūntuki lalkuṟ ṟēmpāy kūntaṉ</l>
        <l>miṉṉiḻai viṟaliyar niṉmaṟam pāṭa</l>
        <l>viravalar puṉkaṇ ṭīra nāṭoṟu</l>
        <l>muraicā ṉaṉkalam varaivila vīci </l>
        <l>yaṉaiyai yākaṉ māṟē yeṉaiyatūu</l>
        <l>muyarnilai yulakattuc cellā tivaṇiṉ</l>
        <l>ṟirunila maruṅki ṉeṭitumaṉ ṉiyarō</l>
        <l>nilantapa viṭūu mēṇip pulampaṭarntu </l>
        <l>paṭukaṇ muraca naṭuvaṇ cilaippat </l>
        <l>tōmara valattar nāmañ ceymmā </l>
        <l>rēval viyaṅkoṇ ṭiḷaiyaro ṭeḻutaru</l>
        <l>mollār yāṉai kāṇi</l>
        <l><hi rend="bold">ṉillāt tāṉai</hi> yiṟaikiḻa vōyē.</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

