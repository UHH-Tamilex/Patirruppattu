<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: centuṟaip pāṭāṇpāṭṭu, vaṇṇam: oḻukuvaṇṇam, tūkku: centūkku.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati4.31">
        <l>kuṉṟutalai maṇantu kuḻuuk kaṭaluṭutta</l>
        <l>maṇkeḻu ñālattu mānta rorāṅkuk</l>
        <l>kaicuman talaṟum pūcaṉ mātirattu</l>
        <l>nālvēṟu naṉantalai yoruṅkeḻun tolippat</l>
        <l>teḷḷuyar vaṭimaṇi yeṟiyunar kalleṉa</l>
        <l>vuṇṇāp paiññilam paṉittuṟai maṇṇi</l>
        <l>vaṇṭūtu politārt tiruñema rakalattuk</l>
        <l>kaṇporu tikirik <hi rend="bold">kamaḻkuraṟ ṟuḻāa</hi></l>
        <l>yalaṅkaṟ celvaṉ cēvaṭi paravi</l>
        <l>neñcumali yuvakaiyar tuñcupatip peyara</l>
        <l>maṇiniṟa maiyiru ḷakala nilāviripu</l>
        <l>kōṭukūṭu matiya miyaluṟ ṟāṅkut</l>
        <l>tuḷaṅkukuṭi viḻuttiṇai tirutti muracukoṇ</l>
        <l>ṭāṇkaṭaṉiṟuttaniṉpūṇkiḷarviyaṉmārpu</l>
        <l>karuvivāṉantaṇṭaḷitalaiiya</l>
        <l>vaṭateṟku vilaṅki vilakutalait teḻiliya</l>
        <l>paṉivār viṇṭūu viṟalvarai yaṟṟē</l>
        <l>kaṭavu ḷañci vāṉat tiḻaitta</l>
        <l>tūṅkeyiṟ katavaṅ kāval koṇṭa</l>
        <l>veḻūu nivantaṉṉa parēreṟuḻ muḻavuttōḷ</l>
        <l>veṇṭirai munnīr vaḷaiiya vulakattu</l>
        <l>vaṇpukaḻ niṟutta vakaicāl celvattu</l>
        <l>vaṇṭa ṉaṉaiyaima ṉīyē vaṇṭupaṭa</l>
        <l>volinta kūnta laṟañcāl kaṟpiṟ</l>
        <l>kuḻaikkuviḷak kākiya voṇṇutaṟ poṉṉi</l>
        <l>ṉiḻaikkuviḷak kākiya vavvāṅ kunti</l>
        <l>vicumpuvaḻaṅku makaḷi ruḷḷuñci ṟanta</l>
        <l>cemmī ṉaṉaiyaṇiṉ ṟoṉṉakarc celvi</l>
        <l>nilaṉatir piraṅkala vāki valaṉērpu</l>
        <l>viyaṉpaṇai muḻaṅkum vēṉmū caḻuvat</l>
        <l>taṭaṅkiya puṭaiyaṟ polaṅkaḻa ṉōṉṟā</l>
        <l>ḷoṭuṅkāt tevva rūkkaṟak kaṭaiip</l>
        <l>puṟakkoṭai yeṟiyārniṉ maṟappaṭai koḷḷunar</l>
        <l>nakaivark karaṇa mākip pakaivarkkuc</l>
        <l>cūrnikaḻn taṟṟuniṉ ṟāṉai</l>
        <l>pōrmiku kuruciṉī māṇṭaṉai palavē.</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

