<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: centuṟaip pāṭāṇpāṭṭu, vaṇṇam: atu, tūkku: atu.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati5.47">
        <l>aṭṭā ṉāṉē kuṭṭuva ṉaṭutoṟum</l>
        <l>peṟṟā ṉārē paricilar kaḷiṟē</l>
        <l>varaimicai yiḻitaru maruviyiṉ māṭattu</l>
        <l>vaḷimuṉai yavirvaruṅ koṭinuṭaṅku teruviṟ</l>
        <l>coricurai kavaru neyvaḻi purāliṟ</l>
        <l>pāṇṭil viḷakkup parūuccuṭa raḻala</l>
        <l><hi rend="bold">naṉṉutal viṟaliya r</hi>āṭun</l>
        <l>toṉṉakar varaippiṉava ṉuraiyā ṉāvē.</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

