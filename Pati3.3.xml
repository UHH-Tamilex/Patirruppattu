<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: vañcittuṟaip pāṭāṇpāṭṭu, vaṇṇam: oḻukuvaṇṇam, tūkku: centūkku.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati3.23">
        <l>alantalai yuṉṉat taṅkavaṭu poruntic</l>
        <l>citaṭi karaiyap peruvaṟaṅ kūrntu</l>
        <l>nilampai taṟṟa pulaṅkeṭu kālaiyum</l>
        <l>vāṅkupu tacaitta kalappaiya rāṅkaṇ</l>
        <l>maṉṟam pōntu maṟukuciṟai pāṭum</l>
        <l>vayiriya mākkaḷ kaṭumpaci nīṅkap</l>
        <l>poṉcey puṉaiyiḻai yolippap perituvantu</l>
        <l>neñcumali yuvakaiya ruṇṭu malintāṭac</l>
        <l>ciṟumaki ḻāṉum peruṅkalam vīcum</l>
        <l>pōraṭu tāṉaip polantārk kuṭṭuva</l>
        <l>niṉṉayantu varuvēṅ kaṇṭaṉam puṉmikku</l>
        <l>vaḻaṅkuna raṟṟeṉa maruṅkukeṭat tūrntu</l>
        <l>peruṅkavi ṉaḻinta vāṟṟa vēṟupuṇarn</l>
        <l>taṇṇaṉ maraiyā vamarntiṉi tuṟaiyum</l>
        <l>viṇṇuyar vaippiṉa kāṭāyiṉa vēniṉ</l>
        <l>maintumali perumpuka ḻaṟiyār malainta</l>
        <l>pōretir vēntar tāraḻin torāliṉ</l>
        <l>marutimiḻn tōṅkiya naṉiyirum parappiṉ</l>
        <l>maṇaṉmali peruntuṟait <hi rend="bold">tatainta kāñci</hi>yoṭu</l>
        <l>murukuttāḻ peḻiliya neruppuṟa ḻaṭaikarai</l>
        <l>nantu nāraiyoṭu cevvari yukaḷuṅ</l>
        <l>kaḻaṉi vāyiṟ paḻaṉap paṭappai</l>
        <l>yaḻaṉmaruḷ pūviṉ ṟāmarai vaḷaimakaḷ</l>
        <l>kuṟāatu malarnta vāmpa</l>
        <l>laṟāa yāṇa rakaṉṟalai nāṭē</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

