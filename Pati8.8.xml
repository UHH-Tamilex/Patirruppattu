<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: viṟali yāṟṟuppaṭai, vaṇṇam: atu, tūkku: atu.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati8.78">
        <l>valampaṭu muraci ṉilaṅkuvaṉa viḻūu</l>
        <l>mavveḷ ḷaruvi yuvvarai yatuvē </l>
        <l>cilvaḷai viṟali celkuvai yāyiṉ </l>
        <l>vaḷḷitaḻt tāmarai neytalo ṭarintu</l>
        <l>melliyaṉ makaḷirol kuvaṉa riyalik</l>
        <l>kiḷikaṭi mēvalar puṟavutoṟu nuvalap</l>
        <l>palpaya ṉilaiiya kaṭaṟuṭai vaippiṉ</l>
        <l>velpō rāṭavar maṟampurintu kākkum</l>
        <l>vilpayi liṟumpiṟ ṟakaṭūur nūṟi</l>
        <l>pēe maṉṟa <hi rend="bold">piṟaḻanōk kiyava</hi></l>
        <l>rōṭuṟu kaṭumuraṇ ṭumiyac ceṉṟu</l>
        <l>vemmuṉai taputta kālai tannāṭ</l>
        <l>ṭiyāṭuparan taṉṉa māvi</l>
        <l>ṉāparan taṉṉa yāṉaiyōṉ kuṉṟē.</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

