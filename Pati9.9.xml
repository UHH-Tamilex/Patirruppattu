<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: kāvaṉ mullai, vaṇṇam: atu, tūkku: atu.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati9.89">
        <l>vāṉam poḻutoṭu curappak kāṉaṅ</l>
        <l>kāṭuṟu maṭamā ṉēṟupuṇarn tiyalap</l>
        <l>puḷḷu miñiṟu mācciṉai parappap</l>
        <l>paḻaṉuṅ kiḻaṅku micaiyaṟa vaṟiyātu</l>
        <l>pallā ṉaṉṉirai pullarun tukaḷap</l>
        <l>payaṅkaṭai yaṟiyā vaḷaṅkeḻu ciṟappiṟ</l>
        <l>perumpal yāṇark kūlaṅ keḻuma </l>
        <l>naṉpal lūḻi naṭuvuniṉ ṟoḻukap </l>
        <l>palvē lirumpoṟai niṉkōl cemmaiyi</l>
        <l>ṉāḷi ṉāḷi ṉāṭutoḻu tētta</l>
        <l>viyaṉilai yulakat tuyarntōr parava</l>
        <l>varaciyal piḻaiyātu cerumēn tōṉṟi</l>
        <l>nōyilai yākiyar nīyē niṉmāṭ</l>
        <l>ṭaṭaṅkiya neñcam pukarpaṭu paṟiyātu</l>
        <l>kaṉaviṉum piriyā vuṟaiyuḷoṭu taṇṇeṉat</l>
        <l>takara nīviya <hi rend="bold">tuvarāk kūntal</hi></l>
        <l>vatuvai makaḷir nōkkiṉar peyarntu</l>
        <l>vāḻnā ḷaṟiyum vayaṅkucuṭar nōkkattu</l>
        <l>mīṉoṭu puraiyuṅ kaṟpiṉ</l>
        <l>vāṇuta larivaiyoṭu kāṇvarap polintē.</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

