<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: centuṟaip pāṭāṇpāṭṭu, vaṇṇam: oḻukuvaṇṇam, tūkku: centūkku.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati3.27">
        <l>citaintu maṉṟanī civantaṉai nōkkaliṟ</l>
        <l><hi rend="bold">ṟoṭarnta kuvaḷait</hi> tūneṟi yaṭaicci</l>
        <l>yalarnta vāmpa lakamaṭi vaiyar</l>
        <l>curiyalañ ceṉṉip pūñcey kaṇṇi</l>
        <l>yariyalār kaiya riṉitu kūṭiyavar</l>
        <l>tuṟaimaṇi maruta mēṟit teṟumā</l>
        <l>relvaḷai makaḷir teḷviḷi yicaippiṟ</l>
        <l>paḻaṉak kāviṟ pacumayi lālum</l>
        <l>poykai vāyiṟ puṉalporu putavi</l>
        <l>ṉeytaṉ marapi ṉiraikaṭ ceṟuviṉ</l>
        <l>valvā yuruḷi katumeṉa maṇṭi </l>
        <l>vaḷḷaṟ paṭṭut tuḷḷupu turappa</l>
        <l>nallerutu muyalu maḷaṟupōku viḻumattuc</l>
        <l>cākāṭ ṭāḷar kampalai yallatu</l>
        <l>pūca laṟiyā niṉṉāṭ</l>
        <l>ṭiyāṇa raṟāak kāmaru kaviṉē.</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

