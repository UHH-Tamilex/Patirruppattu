<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: viṟali yāṟṟuppaṭai, vaṇṇam: atu, tūkku: atu.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati9.87">
        <l>ceṉmō pāṭiṉi naṉkalam peṟukuvai</l>
        <l>cantam pūḻiloṭu poṅkunurai cumantu</l>
        <l>teṇkaṭaṉ muṉṉiya <hi rend="bold">veṇṭalaic cempuṉa</hi></l>
        <l>loyyu nīrvaḻik karumpiṉum</l>
        <l>palvēṟ poṟaiyaṉ vallaṉā laḷiyē.</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

