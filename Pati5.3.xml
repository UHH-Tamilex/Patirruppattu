<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: iyaṉmoḻi vāḻttu, vaṇṇam: atu , tūkku: atu.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati5.43">
        <l>kavarimuccik kārvirikūnta</l>
        <l>lūcaṉ mēvaṟ cēyiḻai makaḷi</l>
        <l>ruralpōṟ peruṅkā lilakuvāṇ maruppiṟ</l>
        <l>peruṅkai matamāp pukutari ṉavaṟṟuḷ</l>
        <l>viruntiṉ vīḻpiṭi yeṇṇumuṟai peṟāak</l>
        <l>kaṭavu ṇilaiiya kallōṅku neṭuvarai</l>
        <l>vaṭaticai yellai yimaiya mākat</l>
        <l>teṉṉaṅ kumariyo ṭāyiṭai yaracar</l>
        <l>muracuṭaip peruñcaman tataiya vārppeḻac</l>
        <l>colpala nāṭṭait tolkavi ṉaḻitta</l>
        <l>pōraṭu tāṉaip polantārk kuṭṭuva </l>
        <l>virumpaṇai tiraṅkap perumpeya loḷippak</l>
        <l>kuṉṟuvaṟaṅ kūrac cuṭarciṉan tikaḻa</l>
        <l>varuvi yaṟṟa peruvaṟaṟ kālaiyu</l>
        <l>maruñcelaṟ periyāṟ ṟiruṅkarai yuṭaittuk</l>
        <l>kaṭiyēr pūṭṭunar kaṭukkai malaiya</l>
        <l>varaivi latircilai muḻaṅkip peyalciṟan </l>
        <l>tārkali vāṉan taḷicorin tāaṅ</l>
        <l>kuṟuva rāra vōmpā tuṇṭu</l>
        <l>nacaiva rāra naṉkalañ citaṟi</l>
        <l>yāṭuciṟai yaṟutta narampucē riṉkuraṟ</l>
        <l>pāṭu viṟaliyar palpiṭi peṟuka</l>
        <l>tuyvī vākai nuṇkoṭi yuḻiñai</l>
        <l>veṉṟi mēva lurukeḻu ciṟappiṟ</l>
        <l>koṇṭi maḷḷar kolkaḷiṟu peṟuka</l>
        <l>maṉṟam paṭarntu maṟukuciṟaip pukkuk</l>
        <l>kaṇṭi nuṇkōl koṇṭukaḷam vāḻttu</l>
        <l>makavalaṉ peṟuka māvē yeṉṟu</l>
        <l>mikalviṉai mēvalai yākaliṟ pakaivarun</l>
        <l>tāṅkātu pukaḻnta tūṅkukoḷai muḻaviṟ</l>
        <l>ṟolaiyāk kaṟpaniṉ ṉilaikaṇ ṭikumē</l>
        <l>niṇañcuṭu pukaiyoṭu kaṉalciṉan tavirātu</l>
        <l>nirampakal laṟiyā v<hi rend="bold">ēṟā vēṇi</hi></l>
        <l>niṟaintu neṭitirāt tacumpiṉ vayiriya</l>
        <l>ruṇṭeṉat tavāak kaḷḷiṉ</l>
        <l>vaṇkai vēntēniṉ kalimaki ḻāṉē.</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

