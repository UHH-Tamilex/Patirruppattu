<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: centuṟaip pāṭāṇpāṭṭu, vaṇṇam: oḻukuvaṇṇam, tūkku: centūkku.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati8.72">
        <l>ikalperu maiyiṟ paṭaikō ḷañcār</l>
        <l>cūḻātu tuṇita lallatu vaṟituṭaṉ</l>
        <l>kāva letirār kaṟuttōr nāṭeṉa </l>
        <l>muṉṟiṇai mutalva rōmpiṉa ruṟaintu</l>
        <l>maṉpatai kāppa vaṟivuvali yuṟuttu</l>
        <l>naṉṟaṟi yuḷḷattuc cāṉṟō raṉṉaniṉ</l>
        <l>paṇpunaṉ kaṟiyār maṭamperu maiyiṟ</l>
        <l>ṟuñca luṟūum pakalpuku mālai</l>
        <l>nilampoṟai peyaranīr ñemaravun tīṇṭi</l>
        <l>yuravuttirai kaṭukiya v<hi rend="bold">urutteḻu veḷḷam</hi></l>
        <l>varaiyā mātirat tiruḷcērpu parantu</l>
        <l>ñāyiṟu paṭṭa vakaṉṟuvaru kūṭṭat</l>
        <l>tañcāṟu puraiyu niṉṟoḻi loḻittup</l>
        <l>poṅkupicir nuṭakkiya ceñcuṭar nikaḻviṉ </l>
        <l>maṭaṅkaṟ ṟīyi ṉaṉaiyai</l>
        <l>ciṉaṅkeḻu kuruciṉiṉ ṉuṭaṟṟici ṉōrkkē.</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

