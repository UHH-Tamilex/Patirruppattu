<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: kuravainilai, vaṇṇam: oḻuku vaṇṇam, tūkku: centūkku.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati6.52">
        <l>koṭinuṭaṅku nilaiya kolkaḷiṟu miṭaintu</l>
        <l>vaṭimaṇi neṭuntēr vēṟupulam parappi</l>
        <l>yaruṅkalan tarīiyar nīrmicai nivakkum</l>
        <l>peruṅkali vaṅkan ticaitirin tāṅku</l>
        <l>maiyaṇin teḻutaru māyirum paḵṟōṉ</l>
        <l>meyputai yaraṇa meṉṉā teḵkucumantu</l>
        <l>muṉcamat teḻutarum vaṉka ṇāṭavar</l>
        <l>tolaiyāt tumpai tevvaḻi viḷaṅka</l>
        <l>vuyarnilai yulaka meytiṉar palarpaṭa</l>
        <l>nallamark kaṭantaniṉ celluṟaḻ taṭakkai</l>
        <l>yirappōrkkuk kavita lallatai yiraiiya</l>
        <l>malarpaṟi yāveṉak kēṭṭiku miṉiyē</l>
        <l>cuṭarum pāṇṭiṟ ṟirunāṟu viḷakkattu</l>
        <l>muḻāvimiḻ tuṇaṅkaikkut taḻūup puṇaiyākac</l>
        <l>cilaippuval lēṟṟiṟ ṟalaikkai tantunī</l>
        <l>naḷintaṉai varuta luṭaṉṟaṉa ḷāki</l>
        <l>yuyaluṅ kōtai yūralan titti</l>
        <l>yīritaḻ maḻaikkaṭ pēri larivai </l>
        <l>yoḷḷita ḻaviḻakaṅ kaṭukkuñ cīṟaṭip</l>
        <l>palcila kiṇkiṇi ciṟupara ṭalaippak</l>
        <l>kolpuṉaṟ ṟaḷiri ṉaṭuṅkuvaṉa ṇiṉṟuniṉ</l>
        <l>ṉeṟiya rōkkiya <hi rend="bold">ciṟuceṅ kuvaḷai</hi></l>
        <l>yīyeṉa virappavu mollā ṇīyemak</l>
        <l>kiyārai yōveṉap peyarvōḷ kaiyatai</l>
        <l>katumeṉa vurutta nōkkamo ṭatunī</l>
        <l>pāal vallā yāyiṉai pāal</l>
        <l>yāṅkuval lunaiyō vāḻkaniṉ kaṇṇi </l>
        <l>yakaliru vicumpiṟ pakaliṭan tarīiyar</l>
        <l>teṟukatir tikaḻtaru murukeḻu ñāyiṟ</l>
        <l>ṟurupukiḷar vaṇṇaṅ koṇṭa</l>
        <l>vāṉṟōy veṇkuṭai vēntartam meyilē.</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

