<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: centuṟaip pāṭāṇpāṭṭu, vaṇṇam: atu, tūkku: atu.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati4.38">
        <l>ulakat tōrē palarmaṟ celva</l>
        <l>rellā ruḷḷuniṉ ṉallicai mikumē</l>
        <l>vaḷantalai mayaṅkiya paitiran tiruttiya</l>
        <l>kaḷaṅkāyk kaṇṇi nārmuṭic cēra </l>
        <l>leyiṉmukañ citaiyat tōṭṭi yēvaliṟ</l>
        <l>ṟōṭṭi tanta toṭimarup piyāṉaic</l>
        <l>cevvuḷaik kalimā vīkai vāṉkaḻaṟ</l>
        <l>ceyalamai kaṇṇic cēralar vēntē</l>
        <l><hi rend="bold">paricilar veṟukkai</hi> pāṇar nāvaḷavai</l>
        <l>vāṇutal kaṇava maḷḷa rēṟē</l>
        <l>maiyaṟa viḷaṅkiya vaṭuvāḻ mārpiṉ </l>
        <l>vacaiyil celva vāṉa varampa</l>
        <l>viṉiyavai peṟiṉē taṉitaṉi nukarkēn</l>
        <l>tarukeṉa viḻaiyāt tāvil neñcattup </l>
        <l>pakuttūṇ ṭokutta vāṇmaip</l>
        <l>piṟarkkeṉa vāḻkanī yākaṉ māṟē.</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

