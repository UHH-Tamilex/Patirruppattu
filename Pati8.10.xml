<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: vañcittuṟaip pāṭāṇpāṭṭu, vaṇṇam: oḻukuvaṇṇam, tūkku: centūkkum vañcittūkkum.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati8.80">
        <l>vāṉmaruppiṟ kaḷiṟṟiyāṉai</l>
        <l>māmalaiyiṟ kaṇaṅkoṇṭava</l>
        <l>reṭutteṟinta viṟaṉmuracaṅ</l>
        <l>kārmaḻaiyiṟ kaṭitumuḻaṅkac</l>
        <l>cāntupularnta viyaṉmārpiṟ</l>
        <l>ṟoṭicuṭarvarum valimuṉkaip</l>
        <l><hi rend="bold">puṇṇuṭai yeṟuḻttōṭ</hi> puṭaiyalaṅ kaḻaṟkāṟ</l>
        <l>piṟakkaṭi yotuṅkāp pūṭkai yoḷvā</l>
        <l>ḷoṭivi ṟevva retirniṉ ṟuraii</l>
        <l>yiṭuka tiṟaiyē puravetirn tōrkkeṉa</l>
        <l>vampuṭai valatta ruyarntōr parava</l>
        <l>vaṉaiyai yākaṉ māṟē pakaivar</l>
        <l>kālkiḷarn taṉṉa kataḻparip puravik</l>
        <l>kaṭumpari neṭuntēr mīmicai nuṭaṅkukoṭi</l>
        <l>pulavarait tōṉṟal yāvatu ciṉappōr</l>
        <l>nilavarai niṟīiya nallicai</l>
        <l>tolaiyāk kaṟpaniṉ ṟemmuṉai yāṉē.</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

