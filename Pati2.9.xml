<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: pariciṟṟuṟaip pāṭāṇpāṭṭu, vaṇṇam: oḻukuvaṇṇamuñ coṟcīr vaṇṇamum, tūkku: centūkku.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati2.19">
        <l>koḷḷai valcik kavarkāṟ kūḷiyar</l>
        <l>kalluṭai neṭuneṟi pōḻntucura ṉaṟuppa</l>
        <l>voṇpoṟik kaḻaṟkāṉ māṟā vayavar</l>
        <l>tiṇpiṇi yeḵkam puliyuṟai kaḻippac</l>
        <l>ceṅkaḷa viruppoṭu kūla muṟṟiya</l>
        <l>vuruvac centiṉai kurutiyoṭu tūuy</l>
        <l>maṇṇuṟu muracaṅ kaṇpeyart tiyavar</l>
        <l>kaṭippuṭai valattar toṭittō ḷōcca</l>
        <l>vampukaḷai vaṟiyāc cuṟṟamō ṭamputerin</l>
        <l>tavviṉai mēvalai yākali</l>
        <l>ṉellu naṉiyirun tellip peṟṟa</l>
        <l>varitupeṟu pāyaṟ ciṟumaki ḻāṉuṅ</l>
        <l>kaṉaviṉu ḷuṟaiyum peruñcāl poṭuṅkiya</l>
        <l>nāṇumali yākkai vāṇuta larivaik</l>
        <l>kiyarko laḷiyai</l>
        <l>yiṉantō ṭakala vūruṭa ṉeḻuntu</l>
        <l>nilaṅkaṇ vāṭa nāñcil kaṭintunī</l>
        <l>vāḻta līyā <hi rend="bold">vaḷaṉaṟu paitira</hi></l>
        <l>maṉṉa vāyiṉa paḻaṉan tōṟum</l>
        <l>maḻaṉmali tāmarai yāmpaloṭu malarntu</l>
        <l>nelliṉ ceṟuvi ṉeytal pūppa</l>
        <l>varinar koyvāṇ maṭaṅka vaṟainar</l>
        <l>tīmpiḻi yentiram pattal varunta</l>
        <l>viṉṟō vaṉṟō toṉṟōr kālai</l>
        <l>nallama ṉaḷiya tāmeṉac collik</l>
        <l>kāṇunar kaipuṭait tiraṅka</l>
        <l>māṇā māṭciya māṇṭaṉa palavē</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>
