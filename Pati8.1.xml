<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: centuṟaip pāṭāṇpāṭṭu, vaṇṇam: oḻukuvaṇṇamum coṟcīrvaṇṇamum, tūkku: centūkku.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati8.71">
        <l>aṟāa yāṇa rakaṉkaṭ ceṟuvi</l>
        <l>ṉaruvi yāmpa ṉeytalo ṭarintu</l>
        <l>ceṟuviṉai makaḷir malinta vekkaip</l>
        <l>parūuppaka ṭutirtta meṉcen nelli</l>
        <l>ṉampaṇa vaḷavai yuṟaikuvit tāṅkuk</l>
        <l>kaṭuntē ṟuṟukiḷai mocintaṉa tuñcuñ</l>
        <l>ceḻuṅkūṭu kiḷaitta viḷantuṇai makāari</l>
        <l>ṉalantaṉar perumaniṉ ṉuṭaṟṟi yōrē</l>
        <l>yūreri kavara vurutteḻun turaiip</l>
        <l>pōrpucuṭu kamaḻpukai mātira maṟaippa</l>
        <l>matilvāyt, tōṉṟa līyā tampaḻi yūkkunar </l>
        <l>kuṇṭuka ṇakaḻiya <hi rend="bold">kuṟuntāṇ ñāyi</hi></l>
        <l>lāreyiṟ ṟōṭṭi vauviṉai yēṟoṭu </l>
        <l>kaṉṟuṭai yāyan tarīip pukalciṟantu </l>
        <l>pulavuvil liḷaiya raṅkai viṭuppa</l>
        <l>mattukkayi ṟāṭā vaikaṟpoḻutu niṉaiyūu </l>
        <l>vāṉpayam vāḻnar kaḻuvuṭalai maṭaṅkap </l>
        <l>patipā ḻāka vēṟupulam paṭarntu </l>
        <l>viruntiṉ vāḻkkaiyoṭu peruntiru vaṟṟeṉa </l>
        <l>varuñcamat tarunilai tāṅkiya pukarnutaṟ</l>
        <l>peruṅkaḷiṟṟi yāṉaiyo ṭaruṅkalan tarāar </l>
        <l>meypaṉi kūrā vaṇaṅkeṉap parāvaliṟ </l>
        <l>palikoṇṭu peyarum pācam pōlat</l>
        <l>tiṟaikoṇṭu peyarti vāḻkaniṉ ṉūḻi </l>
        <l>yuravaru maṭavaru maṟivuterin teṇṇi</l>
        <l>yaṟintaṉai yaruḷā māyiṉ</l>
        <l>yāvariva ṇeṭuntakai vāḻu mōrē.</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

