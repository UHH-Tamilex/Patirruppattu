<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: centuṟaip pāṭāṇpāṭṭu, vaṇṇam: atu, tūkku: atu.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati6.53">
        <l>veṉṟukalan tarīiyar vēṇṭu pulattavar</l> 
        <l>vāṭā yāṇar nāṭutiṟai koṭuppa</l>
        <l>nalkiṉai yākumati yemmeṉ ṟaruḷik</l>
        <l>kalpiṟaṅku vaippiṟ kaṭaṟarai yārttaniṉ</l>
        <l>ṟolpukaḻ mūtūrc celkuvai yāyiṟ</l>
        <l>cempoṟic cilampo ṭaṇittaḻai tūṅku</l>
        <l>mentirat tacaippi ṉampuṭai vāyiṟ</l>
        <l>kōḷvaṉ mutalaiya <hi rend="bold">kuṇṭuka ṇakaḻi</hi></l>
        <l>vāṉuṟa vōṅkiya vaḷaintucey puricai</l>
        <l>yoṉṉāt tevvar muṉaikeṭa vilaṅki</l>
        <l>niṉṉiṟ ṟanta maṉṉeyi lallatu</l>
        <l>muṉṉum piṉṉuniṉ muṉṉō rōmpiya</l>
        <l>veyiṉmukap paṭuttal yāvatu vaḷaiyiṉum</l>
        <l>piṟitāṟu ceṉmati ciṉaṅkeḻu kuruci</l>
        <l>leḻūuppuṟan tarīip poṉpiṇip palakaik</l>
        <l>kuḻūunilaip putaviṟ katavumey kāṇiṟ</l>
        <l>ṟēmpāy kaṭāttoṭu kāḻkai nīvi</l>
        <l>vēṅkai veṉṟa poṟikiḷar pukarnuta</l>
        <l>lēntukai curuṭṭit tōṭṭi nīvi</l>
        <l>mēmpaṭu velkoṭi nuṭaṅkat</l>
        <l>tāṅka lākā vāṅkuniṉ kaḷiṟē.</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

