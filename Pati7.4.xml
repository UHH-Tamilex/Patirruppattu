<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: kāṭcivāḻttu, vaṇṇam: atu, tūkku: atu.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati7.64">
        <l>valampaṭu muraciṉ vāyvāṭ koṟṟattup</l>
        <l>polampūṇ vēntar palartil lamma</l>
        <l>vaṟaṅkaraintu vayaṅkiya nāviṟ piṟaṅkiya</l>
        <l>v<hi rend="bold">uraicāl vēḷvi</hi> muṭitta kēḷvi</l>
        <l>yantaṇa raruṅkala mēṟpa nīrpaṭ</l>
        <l>ṭiruñcē ṟāṭiya maṇmali muṟṟattuk</l>
        <l>kaḷinilai muṇaiiya tārarun takaippiṟ</l>
        <l>puṟañciṟai vayiriyark kāṇiṉ vallē</l>
        <l>yeḵkupaṭai yaṟutta koycuvaṟ puravi</l>
        <l>yalaṅkum pāṇṭi liḻaiyaṇin tīmeṉa</l>
        <l>vāṉāk koḷkaiyai yāka livvayiṉ </l>
        <l>māyiru vicumpiṟ paṉmī ṉoḷikeṭa</l>
        <l>ñāyiṟu tōṉṟi yaṉṉa māṟṟā</l>
        <l>ruṟumuraṇ citaittaniṉ ṉōṉṟāḷ vāḻttik</l>
        <l>kāṇku vanticiṟ kaḻaṟoṭi yaṇṇaṉ</l>
        <l>maipaṭu malarkkaḻi malarnta neyta</l>
        <l>ṉitaḻvaṉap puṟṟa tōṟṟamo ṭuyarnta</l>
        <l>maḻaiyiṉum perumpayam poḻiti yataṉāṟ</l>
        <l>paciyuṭai yokkalai yorīiya</l>
        <l>vicaimēn tōṉṟaṉiṉ pācaṟai yāṉē.</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

