<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: centuṟaip pāṭāṇpāṭṭu, vaṇṇam: oḻukuvaṇṇam, tūkku: centūkku.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati8.76">
        <l>kaḷiṟuṭaip peruñcaman tataiya veḵkuyart</l>
        <l>toḷiṟuvāṇ maṉṉar tatainilai koṉṟu </l>
        <l>muracukaṭip paṭaiya varuntuṟai pōkip </l>
        <l>peruṅkaṭa ṉīntiya maramvali yuṟukkum </l>
        <l>paṇṇiya viṉaivar pōlap puṇṇorīip</l>
        <l>peruṅkait toḻutiyiṉ vāṉṟuyar kaḻippi</l>
        <l>yirantōr vāḻa nalki yirappōrk</l>
        <l>kīta ṟaṇṭā <hi rend="bold">mācita ṟirukkai</hi></l>
        <l>kaṇṭaṉeṉ celku vantaṉeṉ kālkoṇṭu</l>
        <l>karuvi vāṉan taṇṭaḷi corinteṉap</l>
        <l>palvitai yuḻaviṟ cillē rāḷar </l>
        <l>paṉittuṟaip pakaṉṟaip pāṅkuṭait teriyal</l> 
        <l>kaḻuvuṟu kaliṅkaṅ kaṭuppac cūṭi </l>
        <l>yilaṅkukatirt tirumaṇi peṟūu </l>
        <l>makaṉkaṇ vaippi ṉāṭukiḻa vōyē.</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

