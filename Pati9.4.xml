<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: vākai, vaṇṇam: atu, tūkku: atu.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati9.84">
        <l>eṭuttē ṟēya kaṭippuṭai yatirum</l>
        <l>pōrppuṟu muracaṅ kaṇṇatirn tāṅkuk</l>
        <l>kārmaḻai muḻakkiṉ veḷilpiṇi nīvi</l>
        <l>nutalaṇan tērun <hi rend="bold">toḻiṉavil yāṉai</hi>p </l>
        <l>pārvaṟ pācaṟait tarūum palvēṟ</l>
        <l>pūḻiyar kōvē polantērp poṟaiya</l>
        <l>maṉpatai cavaṭṭuṅ kūṟṟa muṉpa</l>
        <l>koṭinuṭaṅ kāreyi leṇṇuvaram paṟiyā</l>
        <l>paṉmā parantapula meṉṟeṇ ṇātu</l>
        <l>valiyai yātaṉaṟ kaṟintaṉa rāyiṉum </l>
        <l>vārmukiṉ muḻakkiṉ maḻakaḷiṟu mitittaṅ</l>
        <l>kāṉmuḷai mūṅkiṟ kavarkiḷai pōla</l>
        <l>vuytalyā vatuniṉ ṉuṭaṟṟi yōrē</l>
        <l>vaṇaṅka laṟiyā ruṭaṉṟeḻun turaiip</l>
        <l>pōrppuṟu taṇṇumai yārppeḻuntu nuvala</l>
        <l>nōyttoḻiṉ malainta vēlīṇ ṭaḻuvattu</l>
        <l>muṉaipukal pukalviṉ māṟā maintarō</l>
        <l>ṭurumeṟi varaiyiṟ kaḷiṟunilañ cērak</l>
        <l>kāñci cāṉṟa ceruppala ceytuniṉ</l>
        <l>kuvavukkurai yirukkai yiṉitukaṇ ṭikumē</l>
        <l>kālai māri peytutoḻi lāṟṟi</l>
        <l>viṇṭu muṉṉiya puyaṉeṭuṅ kālaik</l>
        <l>kalcēr māmaḻai talaiiya</l>
        <l>palkuraṟ puḷḷi ṉoliyeḻun tāṅkē.</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

