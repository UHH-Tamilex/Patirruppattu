<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: centuṟaip pāṭāṇ pāṭṭu, vaṇṇam: oḻuku vaṇṇam, tūkku: centūkku.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati2.15">
        <l>yāṇṭu talaippeyara  vēṇṭu pulattiṟuttu</l>
        <l>muṉaiyeri parappiya tuṉṉaruñ cīṟṟamoṭu</l>
        <l>maḻaitavaḻpu talaiiya matiṉmara murukki</l>
        <l>niraikaḷi ṟoḻukiya <hi rend="bold">niraiya veḷḷam</hi></l>
        <l>parantāṭu kaḻaṅkuvaḻi maṉmaruṅ kaṟuppak</l>
        <l>koṭiviṭu kurūuppukai picirak kālpora</l>
        <l>vaḻalkavar maruṅki ṉuruvaṟak keṭuttut</l>
        <l>tolkavi ṉaḻinta kaṇṇakaṉ vaippiṉ</l>
        <l>veṇpū vēḷaiyoṭu paiñcurai kalittup</l>
        <l>pīrivarpu paranta nīraṟu niṟaimutaṟ 	</l>
        <l>civanta kāntaṇ mutalcitai mūtiṟ</l>
        <l>pulavuvil luḻaviṟ pullāḷ vaḻaṅkum</l>
        <l>pullilai vaippiṟ pulañcitai yarampi</l>
        <l>ṉaṟiyā maiyāṉ maṟantutup petirntaniṉ</l>
        <l>pakaivar nāṭuṅ kaṇṭuvan ticiṉē</l>
        <l>kaṭalavuṅ kallavum yāṟṟavum piṟavum</l>
        <l>vaḷampala nikaḻtaru naṉantalai naṉṉāṭṭu</l>
        <l>viḻavaṟu paṟiyā muḻavimiḻ mūtūrk</l>
        <l>koṭiniḻaṟ paṭṭa poṉṉuṭai niyamattuc</l>
        <l>cīrpeṟu kalimaki ḻiyampu maraciṉ</l>
        <l>vayavar vēntē paricilar veṟukkai </l>
        <l>tāraṇin teḻiliya toṭicitai maruppiṟ</l>
        <l>pōrval yāṉaic cēra lāta</l>
        <l>nīvā ḻiyariv vulakat tōrkkeṉa</l>
        <l>vuṇṭurai māṟiya maḻalai nāviṉ</l>
        <l>meṉcoṟ kalappaiyar tiruntutoṭai vāḻtta</l>
        <l>veytuṟa vaṟiyātu nantiya vāḻkkaic</l>
        <l>ceytaṉ mēva lamarnta cuṟṟamō</l>
        <l>ṭoṉṟumoḻin taṭaṅkiya koḷkai yeṉṟum</l>
        <l>patipiḻaip paṟiyātu tuytta leyti</l>
        <l>niraiya morīiya vēṭkaip puraiyōr</l>
        <l>mēyiṉa ruṟaiyum palarpukaḻ paṇpi</l>
        <l>ṉīpuṟan tarutali ṉōyikan torīiya</l>
        <l>yāṇar naṉṉāṭuṅ kaṇṭumati maruṇṭaṉeṉ</l>
        <l>maṇṇuṭai ñālattu maṉṉuyirk keñcā</l>
        <l>tīttukkai taṇṭāk kaikaṭun tuppiṟ</l>
        <l>puraivayiṟ puraivayiṟ periya nalki</l>
        <l>yēma mākiya cīrkeḻu viḻavi</l>
        <l>ṉeṭiyō ṉaṉṉa nallicai</l>
        <l>yoṭiyā maintaniṉ paṇpupala nayantē</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>
