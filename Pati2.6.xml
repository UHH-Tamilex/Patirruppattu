<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: centuṟaip pāṭāṇ pāṭṭu, vaṇṇam: oḻuku vaṇṇam, tūkku: centūkku.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati2.16">
        <l>kōṭuṟaḻn teṭutta koṭuṅka ṇiñci</l>
         <l>nāṭukaṇ ṭaṉṉa kaṇaituñcu vilaṅkaṟ</l>
         <l>ṟuñcumarak kuḻāan tuvaṉṟip puṉiṟṟumakaḷ</l>
         <l>pūṇā vaiyavi tūkkiya matila</l>
         <l>nalleḻi ṉeṭumputavu murukkik kollu</l>
         <l>pēṉa mākiya nuṉaimuri maruppiṟ</l>
         <l>kaṭāam vārntu kaṭuñciṉam potti</l>
         <l>maraṅkoṉ maḻakaḷiṟu muḻaṅkum pācaṟai</l>
         <l>nīṭiṉai yākaliṟ kāṇkuvan ticiṉē</l>
         <l>yāṟiya kaṟpi ṉaṭaṅkiya cāya</l>
         <l>lūṭiṉu miṉiya kūṟu miṉṉakai</l>
         <l>yamirtupoti tuvarvā yamartta nōkkiṟ</l>
         <l>cuṭarnuta lacainaṭai yaḷḷalu muriyaḷ</l>
         <l>pāya luyyumō tōṉṟa ṟāviṉṟu</l>
         <l>tirumaṇi poruta tikaḻviṭu pacumpoṉ</l>
         <l>vayaṅkukatir vayiramō ṭuṟaḻntu pūṇ cuṭarvara</l>
         <l>veḻumuṭi keḻīiya tiruñema rakalattu</l>
         <l>puraiyō ruṇkaṭ <hi rend="bold">ṭuyiliṉ pāyal</hi></l>
         <l>pāluṅ koḷālum vallōyniṉ</l>
         <l>cāyaṉ mārpu naṉiyalait taṉṟē</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>
