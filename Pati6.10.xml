<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: viṟali yāṟṟuppaṭai, vaṇṇam: atu, tūkku: atu.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati6.60">
        <l>kolaiviṉai mēvaṟṟut tāṉai tāṉē</l>
        <l>yikalviṉai mēvalaṉ ṟaṇṭātu vīcuñ</l>
        <l>cellā mōtil pāṇmakaḷ kāṇiyar </l>
        <l>miñiṟupuṟa mūcavun tīñcuvai tiriyā</l>
        <l>tarampōḻ kallā <hi rend="bold">marampaṭu tīṅkaṉa</hi></l>
        <l>yañcē ṟamainta muṇṭai viḷaipaḻa</l>
        <l>māṟuceṉ mākkaṭ kōytakai taṭukku</l>
        <l>maṟāa viḷaiyu ḷaṟāa yāṇart</l>
        <l>toṭaimaṭi kaḷainta cilaiyuṭai maṟavar</l>
        <l>poṅkupicirp puṇari maṅkuloṭu mayaṅki</l>
        <l>varuṅkaṭa lūtaiyiṟ paṉikkun</l>
        <l>tuvvā naṟaviṉ cāyiṉat tāṉē.</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

