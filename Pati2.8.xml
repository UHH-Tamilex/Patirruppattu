<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: iyaṉmoḻi vāḻttu, vaṇṇam: oḻuku vaṇṇam, tūkku: centūkku.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati2.18">
        <l>uṇmiṉ kaḷḷē yaṭumiṉ cōṟē</l>
        <l>yeṟika tiṟṟi yēṟṟumiṉ puḻukkē</l>
        <l>varunarkku varaiyātu polaṅkalan teḷirppa</l>
        <l>viruḷvaṇa rolivarum puriyavi ḻaimpā</l>
        <l>lēntukōṭ ṭalkuṉ mukiḻnakai maṭavaraṟ</l>
        <l><hi rend="bold">kūntal viṟaliyar</hi> vaḻaṅkuka vaṭuppē</l>
        <l>peṟṟa tutavumiṉ ṟappiṉṟu piṉṉum </l>
        <l>maṉṉuyi raḻiya yāṇṭupala tuḷakki</l>
        <l>maṇṇuṭai ñālam puravetirkoṇṭa</l>
        <l>taṇṇiya leḻili talaiyātu māṟi</l>
        <l>māri poykkuva tāyiṉuñ</l>
        <l>cēra lātaṉ poyyila ṉacaiyē</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>
