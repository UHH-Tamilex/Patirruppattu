<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: centuṟaip pāṭāṇpāṭṭu, vaṇṇam: atu, tūkku: atu.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati5.46">
        <l>iḻaiyar kuḻaiyar naṟuntaṇ mālaiyar</l>
        <l>cuṭarnimi ravirtoṭi ceṟitta muṉkait</l>
        <l>tiṟalviṭu tirumaṇi yilaṅku mārpiṉ</l>
        <l>vaṇṭupaṭu kūntaṉ muṭipuṉai makaḷir</l>
        <l>toṭaipaṭu pēriyāḻ pālai paṇṇip</l>
        <l>paṇiyā marapi ṉuḻiñai pāṭa</l>
        <l>liṉitupuṟan tantavark kiṉmakiḻ curattaliṟ</l>
        <l>curampala kaṭavuṅ <hi rend="bold">karaivāyp paruti</hi></l>
        <l>yūrpāṭ ṭeṇṇil paintalai tumiyap</l>
        <l>palceruk kaṭanta kolkaḷiṟṟi yāṉaik</l>
        <l>kōṭunaral pauvaṅ kalaṅka vēliṭ</l>
        <l>ṭuṭaitiraip parappiṟ paṭukaṭa lōṭṭiya</l>
        <l>velpukaḻk kuṭṭuvaṟ kaṇṭōr </l>
        <l>celva meṇṇār pāṭupu peyarntē</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

