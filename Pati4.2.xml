<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: centuṟaip pāṭāṇpāṭṭu, vaṇṇam: oḻukuvaṇṇam, tūkku: centūkku.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati4.32">
        <l>māṇṭaṉai palavē pōrmiku kuruciṉī</l>
        <l>mātiram viḷakkuñ cālpuñ cemmaiyu </l>
        <l>muttuṭai maruppiṉ maḻakaḷiṟu piḷiṟa</l>
        <l>mikkeḻu kaṭuntār tuyttalaic ceṉṟu</l>
        <l>tupputtuvar pōkap peruṅkiḷai yuvappa</l>
        <l>vīttāṉ ṟāṉā viṭaṉuṭai vaḷaṉum</l>
        <l>tuḷaṅkukuṭi tiruttiya valampaṭu veṉṟiyu</l>
        <l>mellā meṇṇi ṉiṭukaḻaṅku tapuna</l>
        <l>koṉṉoṉṟu maruṇṭaṉe ṉaṭupōrk koṟṟava</l>
        <l>neṭumiṭal cāyak koṭumiṭa ṟumiyap</l>
        <l>perumalai yāṉaiyoṭu pulaṅkeṭa viṟuttut</l>
        <l>taṭantā ṇārai paṭintirai kavaru</l>
        <l>muṭantai nelliṉ <hi rend="bold">kaḻaiyamal kaḻaṉi</hi>p </l>
        <l>piḻaiyā viḷaiyu ṇāṭakap paṭuttu</l>
        <l>vaiyā mālaiyar vacaiyunark kaṟutta</l>
        <l>pakaivar tēet tāyiṉuñ</l>
        <l>ciṉavā yākutali ṟumpūtāṟ peritē.</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

