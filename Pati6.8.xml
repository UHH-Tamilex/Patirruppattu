<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: centuṟaip pāṭāṇpāṭṭu, vaṇṇam: atu, tūkku: atu.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati6.58">
        <l>āṭuka viṟaliyar pāṭuka paricilar</l>
        <l>veṇṭōṭ ṭacaitta voṇpūṅ kuvaḷaiyar</l>
        <l>vāṇmukam poṟitta māṇvari yākkaiyar</l>
        <l>celluṟaḻ maṟavartaṅ kolpaṭait tarīiya</l>
        <l>riṉṟiṉitu nukarntaṉa māyi ṉāḷai</l>
        <l>maṇpuṉai yiñci matilkaṭan talla</l>
        <l>tuṇkuva mallēm pukāveṉak kūṟik</l>
        <l>kaṇṇi kaṇṇiya vayavar perumakaṉ</l>
        <l>poypaṭu paṟiyā vayaṅkucen nāvi</l>
        <l>ṉeyileṟi valvi l<hi rend="bold">ēviḷaṅku taṭakkai</hi></l>
        <l>yēnteḻi lākattuc cāṉṟōr meymmaṟai</l>
        <l>vāṉa varampa ṉeṉpa kāṉattuk</l>
        <l>kaṟaṅkicaic citaṭi poriyaraip poruntiya</l>
        <l>ciṟiyilai vēlam periya tōṉṟum</l>
        <l>puṉpulam vittum vaṉkai viṉaiñar</l>
        <l>cīruṭaip palpaka ṭolippap pūṭṭi</l>
        <l>nāñci lāṭiya koḻuvaḻi maruṅki</l>
        <l>ṉalaṅkukatirt tirumaṇi peṟūu</l>
        <l>makaṉkaṇ vaippi ṉāṭukiḻa vōṉē.</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

