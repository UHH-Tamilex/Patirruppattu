<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: centuṟaip pāṭāṇpāṭṭu, vaṇṇam: atu, tūkku: atu.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati5.45">
        <l>polampūn tumpaip poṟikiḷar tūṇip</l>
        <l>puṟṟaṭaṅ karavi ṉoṭuṅkiya vampi</l>
        <l>ṉocivuṭai villi ṉociyā neñciṟ</l>
        <l>kaḷiṟeṟintu murintu katuvā yeḵkiṉ</l>
        <l>viḻumiyōr tuvaṉṟiya vakaṉka ṇāṭpi</l>
        <l>ṉeḻumuṭi mārpi ṉeytiya cēral</l>
        <l>kuṇṭuka ṇakaḻiya matilpala kaṭantu</l>
        <l>paṇṭum paṇṭuntā muḷḷaḻit tuṇṭa</l>
        <l>nāṭukeḻu tāyattu naṉantalai yaruppattuk</l>
        <l>katavaṅ kākkuṅ kaṇaiyeḻu vaṉṉa</l>
        <l>nilampeṟu tiṇitō ḷuyara vōccip</l>
        <l>piṇampiṟaṅ kaḻuvattut tuṇaṅkai yāṭic</l>
        <l>cōṟuvē ṟeṉṉā v<hi rend="bold">ūṉṟuvai yaṭici</hi></l>
        <l>lōṭāp pīṭa ruḷvaḻi yiṟuttu</l>
        <l>muḷḷiṭu paṟiyā vēṇit tevvar</l>
        <l>cilaivicai yaṭakkiya mūri veṇṭō</l>
        <l>laṉaiya paṇpiṟ ṟāṉai maṉṉa</l>
        <l>riṉiyā ruḷarōniṉ muṉṉu millai</l>
        <l>maḻaikoḷak kuṟaiyātu puṉalpuka niṟaiyātu</l>
        <l>vilaṅkuvaḷi kaṭavun tuḷaṅkiruṅ kamañcūl</l>
        <l>vayaṅkumaṇi yimaippiṉ vēliṭupu</l>
        <l>muḻaṅkutiraip paṉikkaṭaṉ maṟuttici ṉōrē.</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

