<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: tumpai yaravam, vaṇṇam: oḻuku vaṇṇam, tūkku: centūkku.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati9.83">
        <l>kārmaḻai muṉpiṟ kaiparin teḻutarum</l>
        <l>vāṉpaṟaik kuruki ṉeṭuvari poṟpak</l>
        <l>kolkaḷiṟu miṭainta <hi rend="bold">paḵṟōṟ ṟoḻuti</hi>yoṭu</l>
        <l>neṭuntēr nuṭaṅkukoṭi yavirvarap polintu</l>
        <l>celavuperi tiṉituniṟ kāṇu mōrkkē</l>
        <l>yiṉṉā tammavatu tāṉē paṉmā</l>
        <l>ṇāṭukeṭa verukki naṉkalan tarūuniṉ</l>
        <l>pōraruṅ kaṭuñciṉa metirntu</l>
        <l>māṟukoḷ vēntar pācaṟai yōrkkē.</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

