<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: centuṟaip pāṭāṇpāṭṭu, vaṇṇam: atu, tūkku: atu.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati5.44">
        <l>nilampuṭaip paṉṉavārp poṭuvicumpu tuṭaiyū</l>
        <l>vāṉṟōy velkoṭi tērmicai nuṭaṅkap</l>
        <l>periya vāyiṉu mamarkaṭantu peṟṟa</l>
        <l>variya veṉṉā tōmpātu vīcik</l>
        <l>kalañcelac curatta lallatu kaṉaviṉuṅ</l>
        <l>kaḷaikeṉa vaṟiyāk kacaṭi ṉeñcat</l>
        <l>tāṭunaṭai yaṇṇaṉiṟ pāṭumakaḷ kāṇiya</l>
        <l>kāṇi liyarōniṟ pukaḻnta yākkai</l>
        <l>muḻuvali tuñcu <hi rend="bold">nōytapu nōṉṟoṭai</hi></l>
        <l>nuṇkoṭi yuḻiñai velpō raṟukai</l>
        <l>cēṇa ṉāyiṉuṅ kēḷeṉa moḻintu</l>
        <l>pulampeyarn toḷitta kaḷaiyāp pūcaṟ</l>
        <l>karaṇkaṭā vuṟīi yaṇaṅkunikaḻn taṉṉa</l>
        <l>mōkūr maṉṉaṉ muraicaṅ koṉṟu</l>
        <l>neṭumoḻi paṇittavar vēmpumuta ṟaṭintu</l>
        <l>muracuceya muraccik kaḷiṟupala pūṭṭi</l>
        <l>yoḻukai yuytta koḻuvil paintuṇi</l>
        <l>vaittalai maṟanta tuyttalaik kūkai</l>
        <l>kavalai kavaṟṟuṅ kurālam paṟantalai</l>
        <l>muracuṭait tāyat taracupala vōṭṭit</l>
        <l>tuḷaṅkunīr viyalaka māṇṭiṉitu kaḻinta</l>
        <l>maṉṉar maṟaitta tāḻi</l>
        <l>vaṉṉi maṉṟattu viḷaṅkiya kāṭē</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

