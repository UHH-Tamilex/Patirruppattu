<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: centuṟaip pāṭāṇpāṭṭu, vaṇṇam: atu, tūkku: atu.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati4.37">
        <l>vāḻkaniṉ vaḷaṉē niṉṉuṭai vāḻkkai</l>
        <l>vāymoḻi vāyar niṉpuka ḻēttap</l>
        <l>pakaiva rārap paḻaṅka ṇaruḷi</l>
        <l>nacaiva rāra naṉkalañ citaṟi</l>
        <l>yāṉṟavin taṭaṅkiya ceyirtīr cemmal</l>
        <l>vāṉṟōy nallicai yulakamoṭu yirppat</l>
        <l>tuḷaṅkukuṭi tiruttiya <hi rend="bold">valampaṭu veṉṟi</hi>yu</l>
        <l>māyirum puṭaiyaṉ mākkaḻal puṉaintu</l>
        <l>maṉṉeyi leṟintu maṟavart tarīit</l>
        <l>toṉṉilaic ciṟappi ṉiṉṉiḻal vāḻnarkkuk</l>
        <l>kōṭiṟa vaitta kōṭāk koḷkaiyu</l>
        <l>naṉṟuperi tuṭaiyaiyā ṉīyē</l>
        <l>ventiṟal vēntē yivvulakat tōrkkē.</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

