<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: kāṭci vāḻttu, vaṇṇam: oḻuku vaṇṇam, tūkku: centūkku.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati5.41">
        <l>puṇarpuri narampiṉ ṟīntoṭai paḻuniya</l>
        <l>vaṇaramai nalyā ḻiḷaiyar poṟuppap</l>
        <l>paṇṇamai muḻavum patalaiyum piṟavuṅ</l>
        <l>kaṇṇaṟut tiyaṟṟiya tūmpoṭu curukkik</l>
        <l>kāviṟ ṟacaitta tuṟaikūṭu kalappaiyar</l>
        <l>kaiva liḷaiyar kaṭavuṭ paḻicca</l>
        <l>maṟappulik kuḻūukkural cettu vayakkaḷiṟu</l>
        <l>varaicēr peḻunta <hi rend="bold">cuṭarvī vēṅkai</hi>p</l>
        <l>pūvuṭaip peruñciṉai vāṅkip piḷantutaṉ </l>
        <l>māyiruñ ceṉṉi yaṇipeṟa milaiccic</l>
        <l>cēe ruṟṟa celpaṭai maṟavar</l>
        <l>taṇṭuṭai valattar pōretirn tāṅku</l>
        <l>vaḻaiyamal viyaṉkāṭu cilampap piḷiṟu</l>
        <l>maḻaipeyaṉ māṟiya kaḻaitiraṅ katta </l>
        <l>moṉṟiraṇ ṭalapala kaḻintu tiṇṭēr</l>
        <l>vacaiyi ṉeṭuntakai kāṇkuvan ticiṉē</l>
        <l>tāva luyyumō maṟṟē tāvātu</l>
        <l>vañciṉa muṭitta voṉṟumoḻi maṟavar</l>
        <l>muracuṭaip peruñcamat taracupaṭak kaṭantu</l>
        <l>vevva rōccam perukat tevvar</l>
        <l>miḷakeṟi yulakkaiyi ṉiruntalai yiṭittu</l>
        <l>vaikārp peḻunta maipaṭu parappi</l>
        <l>ṉeṭuttē ṟēya kaṭippuṭai viyaṉkaṇ</l>
        <l>valampaṭu cīrtti yoruṅkuṭa ṉiyaintu</l>
        <l>kāluṭaik kaṭumpici ruṭaiya vāluḷaik</l>
        <l>kaṭumparip puravi yūrntaniṉ</l>
        <l>paṭutiraip paṉikkaṭa luḻanta tāḷē.</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

