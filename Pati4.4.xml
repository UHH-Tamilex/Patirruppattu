<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: tumpaiyaravam, vaṇṇam: atu, tūkku: atu.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati4.34">
        <l>orūupa niṉṉai yoruperu vēntē</l>
        <l>yōṭāp pūṭkai y<hi rend="bold">oṇpoṟik kaḻaṟkā</hi></l>
        <l>lirunilan tōyum virinū laṟuvaiyar</l>
        <l>cevvuḷaiya māvūrntu</l>
        <l>neṭuṅkoṭiya tērmicaiyu</l>
        <l>mōṭai viḷaṅku murukeḻu pukarnutaṟ</l>
        <l>poṉṉaṇi yāṉai muraṇcē reruttiṉu</l>
        <l>maṉṉilat tamainta…………. … </l>
        <l>māṟā maintar māṟunilai tēya</l>
        <l>muracuṭaip peruñcaman tataiya vārppeḻa</l>
        <l>varacupaṭak kaṭakku māṟṟaṟ</l>
        <l>puraicāṉ maintanī yōmpaṉ māṟē.</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

