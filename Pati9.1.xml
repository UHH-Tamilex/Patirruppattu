<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: mullai, vaṇṇam: oḻukuvaṇṇam, tūkku: centūkku.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati9.81">
        <l>ulakam purakku murukeḻu ciṟappiṉ</l>
        <l>vaṇṇak karuviya vaḷaṅkeḻu kamañcū</l>
        <l>laṅkaṇiru vicumpi ṉatirciṉañ ciṟantu</l>
        <l>kaṭuñcilai kaḻaṟi vicumpaṭaiyū nivantu</l>
        <l>kālai yicaikkum poḻutoṭu pulampukoḷak</l>
        <l>kaḷiṟupāyn tiyalak kaṭumā tāṅka</l>
        <l>voḷiṟukoṭi nuṭaṅkal tērtirintu koṭpa</l>
        <l>varacupuṟat tiṟuppiṉu matirvilar tirintu</l>
        <l>vāyil koḷḷā maintiṉai vayavar</l>
        <l>māyiruṅ kaṅkulum viḻuttoṭi cuṭarvarat</l>
        <l>tōḷpiṇi mīkaiyar pukalciṟantu nāḷu</l>
        <l>muṭital vēṭkaiyar neṭiya moḻiyūuk</l>
        <l>keṭāa nallicait taṅkuṭi niṟumā</l>
        <l>riṭāa vēṇi viyalaṟaik koṭpa</l>
        <l>nāṭaṭip paṭuttaliṟ koḷḷai māṟṟi</l>
        <l>yaḻalviṉai yamainta <hi rend="bold">niḻalviṭu kaṭṭi</hi></l>
        <l>kaṭṭaḷai valippaniṉ ṟāṉai yutavi</l>
        <l>vēṟupulat tiṟutta velpō raṇṇaṉ</l>
        <l>muḻavi ṉamainta perumpaḻa micaintu</l>
        <l>cāṟayarn taṉṉa tāraṇi yāṇart</l>
        <l>tūmpakam paḻuniya tīmpiḻi māntik</l>
        <l>kāntaṭ kaṇṇic ceḻuṅkuṭic celvar</l>
        <l>kalimakiḻ mēvala riravalark kīyuñ</l>
        <l>curumpār cōlaip perumpeyaṟ kollip</l>
        <l>peruvāy malaroṭu pacumpiṭi makiḻntu</l>
        <l>miṉṉumiḻn taṉṉa cuṭariḻai yāyattut</l>
        <l>taṉṉiṟaṅ karanta vaṇṭupaṭu katuppi</l>
        <l>ṉoṭuṅkī rōti yoṇṇuta laṇikoḷak</l>
        <l>koṭuṅkuḻaik kamartta nōkki ṉayavarap</l>
        <l>peruntakaik kamarnta meṉcoṟ ṟirumukattu</l>
        <l>māṇiḻai yarivai kāṇiya vorunāṭ</l>
        <l>pūṇkai māḷaniṉ puṉaiviṉai neṭuntēr</l>
        <l>muṉaikai viṭṭu muṉṉilaic cellātu</l>
        <l>tūvetirntu peṟāat tūviṉ maḷḷaroṭu</l>
        <l>toṉmaruṅ kaṟutta lañci yaraṇkoṇṭu</l>
        <l>tuñcā vēntarun tuñcuka</l>
        <l>viruntu mākap peruntō ḷāṭkē.</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

