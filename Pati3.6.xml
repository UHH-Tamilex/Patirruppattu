<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: vañcittuṟaip pāṭāṇpāṭṭu, vaṇṇam: oḻukuvaṇṇamum coṟcīrvaṇṇamum, tūkku: centūkkum vañcittūkkum.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati3.26">
        <l>tēerparantapula mēerparavā</l>
        <l>kaḷiṟāṭiyapula nāñci lāṭā</l>
        <l>matturaṟiyamaṉai yiṉṉiyamimiḻā</l>
        <l>vāṅkup, paṇṭunaṟ kaṟiyunar ceḻuvaḷa niṉaippi</l>
        <l>ṉōkō yāṉē nōtaka varumē</l>
        <l>peyaṉmaḻai puraviṉ ṟāki veytuṟṟu</l>
        <l>valamiṉ ṟamma kālaiyatu paṇpeṉak</l>
        <l>kaṇpaṉi malirniṟai tāṅkik kaipuṭaiyūu </l>
        <l>melivuṭai neñciṉar ciṟumai kūrap</l>
        <l>pīrivar vēlip pāḻmaṉai neruñcik</l>
        <l><hi rend="bold">kāṭuṟu kaṭuneṟi</hi> yāka maṉṉiya</l>
        <l>murukuṭaṉṟu kaṟutta kaliyaḻi mūtū</l>
        <l>rurumpil kūṟṟat taṉṉaniṉ</l>
        <l>ṟiruntu toḻilvayavar cīṟiya nāṭē</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

