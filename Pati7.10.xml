<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: centuṟaip pāṭāṇpāṭṭu, vaṇṇam: oḻukuvaṇṇam, tūkku: centūkkum vañcittūkkum.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati7.70">
        <l>kaḷiṟukaṭaiiya tāṇ</l>
        <l>māvuṭaṟṟiya vaṭimpu</l>
        <l>camantatainta vēl</l>
        <l>kallalaitta tōḷ</l>
        <l>villalaitta nalvalattu </l>
        <l>vaṇṭicai kaṭāvāt taṇpaṉam pōntaik</l>
        <l>kuvimuki ḻūci veṇṭōṭu koṇṭu</l>
        <l>tīñcuṉai nīrmalar malaintu matañcerukki</l>
        <l>yuṭainilai nallamar kaṭantu maṟaṅkeṭuttuk</l>
        <l>kaṭuñciṉa vēntar cemma ṟolaitta</l>
        <l>valampaṭu vāṉkaḻal vayavar peruma</l>
        <l>nakaiyiṉum poyyā vāymaip pakaivar</l>
        <l>puṟañcoṟ kēḷāp puraitī rāṇmaip </l>
        <l>peṇmai cāṉṟu perumaṭa nilaiik</l>
        <l>kaṟpiṟai koṇṭa kamaḻuñ cuṭarnutaṟ</l>
        <l>puraiyōḷ kaṇava pūṇkiḷar mārpa</l>
        <l>tolaiyāk koḷkaic cuṟṟañ cuṟṟa</l>
        <l>vēḷviyiṟ kaṭavu ḷaruttiṉai kēḷvi</l>
        <l>yuyarnilai yulakat taiyariṉ puṟuttiṉai </l>
        <l>vaṇaṅkiya cāyal vaṇaṅkā vāṇmai</l>
        <l>yiḷantuṇaip putalvariṉ mutiyarp pēṇit</l>
        <l>tolkaṭa ṉiṟutta velpō raṇṇaṉ</l>
        <l>māṭō ruṟaiyu mulakaṅ kēṭpa</l>
        <l>viḻumeṉa viḻitarum <hi rend="bold">paṟaikkura laruvi</hi></l>
        <l>muḻumutaṉ micaiya kōṭutoṟun tuvaṉṟu</l>
        <l>nēruyar neṭuvarai pōlat</l>
        <l>tolaiyā tatākanī vāḻu nāḷē.</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

