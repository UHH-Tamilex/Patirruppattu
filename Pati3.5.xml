<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: vañcittuṟaip pāṭāṇpāṭṭu, vaṇṇam: oḻukuvaṇṇamum coṟcīrvaṇṇamum, tūkku: centūkkum vañcittūkkum.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati3.25">
        <l>māvāṭiyapula ṉāñcilāṭā</l>
        <l>kaṭāañceṉṉiya kaṭuṅkaṇyāṉai</l>
        <l>yiṉamparantapulam vaḷamparappaṟiyā</l>
        <l>niṉpaṭaiñar, cērnta maṉṟaṅ kaḻutai pōki</l>
        <l>nī, yuṭaṉṟōr maṉṉeyi ṟōṭṭi vaiyār</l>
        <l>kaṭuṅkā loṟṟaliṟ cuṭarciṟan turuttup</l>
        <l>pacumpici roḷḷaḻa lāṭiya maruṅki</l>
        <l>ṉāṇṭalai vaḻaṅkuṅ <hi rend="bold">kāṉuṇaṅku kaṭuneṟi</hi></l>
        <l>muṉaiyakaṉ perumpā ḻāku maṉṉiya</l>
        <l>vurumuṟaḻ piṟaṅku muraciṟ perumalai</l>
        <l>varaiyiḻi yaruviyi ṉoḷiṟukoṭi nuṭaṅkak</l>
        <l>kaṭumparik kataḻciṟa kakaippanī</l>
        <l>neṭuntē rōṭṭiyapiṟa rakaṉṟalai nāṭē.</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

