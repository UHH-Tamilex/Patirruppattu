<text xml:lang="ta" type="edition">
  <body>
    <p>
      tuṟai: iyaṉmoḻi vāḻttu, vaṇṇam: atu, tūkku: atu.
    </p>
    <div rend="parallel">
      <lg xml:id="Pati5.48">
        <l>paimpoṟ ṟāmarai pāṇarc cūṭṭi</l>
        <l>yoṇṇutal viṟaliyark kāram pūṭṭik</l>
        <l>keṭalarum palpukaḻ nilaii nīrpukkuk</l>
        <l>kaṭalo ṭuḻanta paṉittuṟaip paratavā/paratavar</l>
        <l>vāṇṭunīrp peṟṟa tāra mīṇṭivar</l>
        <l>koḷḷāp pāṭaṟ keḷitiṉi ṉīyuṅ</l>
        <l>kallā vāymaiya ṉivaṉeṉat tattaṅ</l>
        <l>kaiva liḷaiyar nērkai nirappa</l>
        <l>vaṇaṅkiya cāyal vaṇaṅkā vāṇmai </l>
        <l>muṉaicuṭu kaṉaiyeri yerittaliṟ peritu</l>
        <l>mitaḻkavi ṉaḻinta mālaiyoṭu cāntupular</l>
        <l>palpoṟi mārpaniṉ peyarvā ḻiyarō</l>
        <l>niṉmalaip piṟantu niṉkaṭaṉ maṇṭu</l>
        <l>malipuṉa ṟikaḻtarun tīnīr viḻaviṟ</l>
        <l>poḻilvati vēṉiṟ <hi rend="bold">pēreḻil vāḻkkai</hi></l>
        <l>mēvaru cuṟṟamō ṭuṇṭiṉitu nukarun </l>
        <l>tīmpuṉa lāya māṭuṅ</l>
        <l>kāñciyam peruntuṟai maṇaliṉum palavē</l>
      </lg>
      <lg type="translation" xml:lang="en">
        <l/>
      </lg>
    </div>
  </body>
</text>

